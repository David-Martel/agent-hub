[Unit]
Description=Export agent-bus history to encrypted private Google Drive custody
Documentation=https://github.com/David-Martel/agent-hub/blob/main/packaging/history-export/README.md
After=network-online.target
OnFailure=agent-hub-history-export-notify@%n.service

[Service]
Type=oneshot
# env.bash gives the unit the same PATH as an interactive shell (uv, agent-bus, psql);
# a bare user-unit PATH lacks the toolchain. flock -n refuses an overlapping run, and
# mkdir -p makes its lock directory exist on a fresh install.
ExecStart=/bin/bash -c 'source "$HOME/.config/bash/env.bash" && mkdir -p "$HOME/.cache" && exec flock -n "$HOME/.cache/agent-hub-history-export.lock" uv run --offline --no-project --with redis python -B "$HOME/.local/share/agent-hub-history-export/agent-hub-history-export.py" --drive'
TimeoutStartSec=2h
UMask=0077
Nice=19
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUQuota=100%
MemoryMax=4G
NoNewPrivileges=true
