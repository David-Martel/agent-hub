#!/bin/sh
# agent-bus-redis-aof-preflight -- ExecStartPre for the agent-bus hub's redis-server.
#
# Why: on 2026-10-26 a power cut left 1155 bad bytes at the tail of the hub's AOF INCR
# file. redis-server refused to load it ("Bad file format reading the append only file"),
# systemd hit the start limit within 2 s, and the whole fleet's agent bus was down until a
# human read the redis log. `aof-load-truncated yes` covers a file that simply ends early,
# not a partially written final command.
#
# What it does, in order:
#   1. No manifest: exit 0 (fresh install, or AOF disabled).
#   2. `redis-check-aof <manifest>` exits 0: exit 0 (the measured cost is 0.38 s for 113 MB).
#   3. Otherwise read the bad byte count (`diff=`) that redis-check-aof reports. Refuse,
#      exit 1, when it is missing or larger than <max-fix-bytes>: a large bad region is not
#      an interrupted write, and truncating it would silently discard real history.
#   4. Copy the whole AOF directory to <dir>.preflight-backup.1, keeping the previous two
#      as .2 and .3. Only then run `redis-check-aof --fix`, which truncates the last INCR
#      file at its last complete command.
#   5. Re-check. Anything but exit 0 refuses the start.
# Every outcome goes to stderr, so it lands in the unit's journal.
#
# It runs inside Redis's own sandbox. Ubuntu's packaged unit sets
# SystemCallFilter=~@privileged, which includes chown, so the backup copy must not preserve
# ownership: `cp -a` calls fchownat and is killed with SIGSYS (measured 2026-10-27 under the
# same filter: code=dumped/status=SYS). It runs as the redis user, so the copy is redis-owned
# anyway. The same unit sets NoExecPaths=/; backend-hardening.sh adds this script, /bin/sh,
# the checker and every command in the exec-deps line below to the drop-in's ExecPaths=.
# Keep that line complete: the fixture runs this script with a PATH holding only those.
# exec-deps: sed awk rm mv cp
#
# Installed by packaging/backend-hardening.sh (packaging/README.md, "Backend hardening").
# Tests: packaging/tests/backend-hardening-test.sh.
#
# Usage: agent-bus-redis-aof-preflight <appendonlydir> <manifest-name> <max-fix-bytes>
set -eu

usage='usage: agent-bus-redis-aof-preflight <appendonlydir> <manifest-name> <max-fix-bytes>'
say() { printf 'agent-bus-redis-aof-preflight: %s\n' "$*" >&2; }

[ $# -eq 3 ] || { say "$usage"; exit 2; }
dir=$1
manifest=$2
max_fix_bytes=$3
check=${AGENT_BUS_REDIS_CHECK_AOF:-redis-check-aof}

case $max_fix_bytes in
    '' | *[!0-9]*) say "max-fix-bytes must be a non-negative integer, got '$max_fix_bytes'"; exit 2 ;;
esac

if [ ! -f "$dir/$manifest" ]; then
    say "no AOF manifest at $dir/$manifest; nothing to check"
    exit 0
fi

cd "$dir"
report=$("$check" "$manifest" 2>&1) && exit 0

# The failing file is the one whose "AOF analyzed" line has a non-zero diff.
bad_bytes=$(printf '%s\n' "$report" \
    | sed -n 's/^.*AOF analyzed: filename=\([^,]*\),.* diff=\([0-9][0-9]*\).*$/\2 \1/p' \
    | awk '$1 > 0 { print $1; exit }')

if [ -z "$bad_bytes" ]; then
    say "AOF check failed without a byte count; refusing to repair. Report follows:"
    printf '%s\n' "$report" >&2
    exit 1
fi

if [ "$bad_bytes" -gt "$max_fix_bytes" ]; then
    say "AOF has $bad_bytes bad bytes, above the $max_fix_bytes-byte repair limit;" \
        "refusing. Recover by hand: back up $dir, then redis-check-aof --fix $manifest."
    printf '%s\n' "$report" >&2
    exit 1
fi

backup="$dir.preflight-backup"
rm -rf "$backup.3"
[ ! -e "$backup.2" ] || mv "$backup.2" "$backup.3"
[ ! -e "$backup.1" ] || mv "$backup.1" "$backup.2"
cp -R --preserve=mode,timestamps "$dir" "$backup.1"
say "AOF has $bad_bytes bad tail bytes; copied $dir to $backup.1, repairing"

printf 'y\n' | "$check" --fix "$manifest" >&2

if "$check" "$manifest" >/dev/null 2>&1; then
    say "AOF repaired; $bad_bytes bytes truncated. The original is in $backup.1"
    exit 0
fi
say "AOF is still invalid after --fix; refusing to start. The original is in $backup.1"
exit 1
