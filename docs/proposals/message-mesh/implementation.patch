+fn message() -> Message {
+    serde_json::from_value(json!({
+        "id": Uuid::now_v7().to_string(), "timestamp_utc":"2026-10-16T00:00:00.000000Z",
+        "protocol_version":"1.0", "from":"sender", "to":"receiver", "topic":"status",
