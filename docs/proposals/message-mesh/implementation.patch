+
+/// Open an existing owner-private file without creating or repairing anything.
+pub(crate) fn open_existing_private(path: &Path) -> Result<File> {
+    plain_path(path)?;
+    let parent = path.parent().context("private file parent required")?;
+    let _parent = platform::validate_directory(parent)?;
+    let metadata = fs::symlink_metadata(path).context("existing private file required")?;
+    if !metadata.is_file() || metadata.file_type().is_symlink() {
+        bail!("regular private file required");
+    }
+    let file = platform::open_existing(path)?;
+    platform::validate_file(&file)?;
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        if file.metadata()?.permissions().mode() & 0o7777 != 0o600 {
+            bail!("exact owner-read-write private file permissions required");
+        }
+    }
+    plain_path(path)?;
+    platform::validate_identity(&file, path)?;
+    Ok(file)
 }

