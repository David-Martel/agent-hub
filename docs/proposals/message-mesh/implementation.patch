+fn event(sequence: i64, message: Message) -> MeshEvent {
+    let payload_sha256 = payload_sha256(&message).unwrap();
+    MeshEvent {
+        sequence,
+        target: MeshTarget::Bus,
+        message,
+        payload_sha256,
+    }
