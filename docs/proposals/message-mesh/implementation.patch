+    #[tokio::test]
+    async fn three_real_peer_workers_converge_a_b_c_a_cycle_and_then_become_quiescent() {
+        let a = source();
+        let b = MemoryStore::default();
+        let c = MemoryStore::default();
+        let server_a =
+            Server::start_with(false, false, "a", &["c"], a.clone(), Duration::ZERO).await;
+        let server_b =
+            Server::start_with(false, false, "b", &["a"], b.clone(), Duration::ZERO).await;
+        let server_c =
+            Server::start_with(false, false, "c", &["b"], c.clone(), Duration::ZERO).await;
+        let (stop, stopped) = watch::channel(false);
+        let mut tasks = Vec::new();
+        let mut statuses = Vec::new();
+        for (local, destination, url, store) in [
+            ("a", "b", &server_b.url, a.clone()),
+            ("b", "c", &server_c.url, b.clone()),
+            ("c", "a", &server_a.url, c.clone()),
+        ] {
+            let config = PeerConfig::new(
+                local.to_owned(),
+                destination.to_owned(),
+                "fixture".to_owned(),
+                url,
+                BearerToken::new("synthetic-peer-fixture"),
+                false,
+            )
+            .unwrap();
+            let worker = PeerWorker::with_timing(config, store, quick_timing()).unwrap();
+            statuses.push(Arc::clone(&worker.status));
+            tasks.push(tokio::spawn(worker.run(stopped.clone())));
+        }
+        tokio::time::timeout(Duration::from_secs(3), async {
+            loop {
+                let counts = [
+                    a.0.lock().unwrap().rows.len(),
+                    b.0.lock().unwrap().rows.len(),
+                    c.0.lock().unwrap().rows.len(),
+                ];
+                if counts == [2, 2, 2]
+                    && a.position("b") == 2
+                    && b.position("c") == 2
+                    && c.position("a") == 2
+                {
+                    break;
+                }
+                tokio::time::sleep(Duration::from_millis(10)).await;
+            }
+        })
+        .await
+        .unwrap();
+        let before: Vec<_> = statuses
+            .iter()
+            .map(|status| status.lock().unwrap().successful_batches)
+            .collect();
+        tokio::time::sleep(Duration::from_millis(100)).await;
+        let after: Vec<_> = statuses
+            .iter()
+            .map(|status| status.lock().unwrap().successful_batches)
+            .collect();
+        assert_eq!(
+            before, after,
+            "cycle must stop forwarding after durable duplicate acknowledgments"
+        );
+        assert!(after.iter().all(|count| *count == 1));
+        let expected: Vec<_> =
+            a.0.lock()
+                .unwrap()
+                .rows
+                .iter()
+                .map(|event| (event.message.id.clone(), event.payload_sha256.clone()))
+                .collect();
+        for store in [&b, &c] {
+            let actual: Vec<_> = store
+                .0
+                .lock()
+                .unwrap()
+                .rows
+                .iter()
+                .map(|event| (event.message.id.clone(), event.payload_sha256.clone()))
+                .collect();
+            assert_eq!(actual, expected);
+        }
+        stop.send(true).unwrap();
+        for task in tasks {
+            tokio::time::timeout(Duration::from_secs(2), task)
+                .await
+                .unwrap()
+                .unwrap();
+        }
+        server_a.finish().await;
+        server_b.finish().await;
+        server_c.finish().await;
+    }
