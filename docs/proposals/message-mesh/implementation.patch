+    fn existing_private_token_accepts_exact_optional_line_endings() {
+        for suffix in ["", "\n", "\r\n"] {
+            let expected = "a".repeat(64);
+            let supplied = format!("{expected}{suffix}");
+            let (_root, path) = fixture(supplied.as_bytes());
