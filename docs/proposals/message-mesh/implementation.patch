+//! Owner-private peer credential loading without creation or secret diagnostics.
+
+use anyhow::{Result, anyhow, bail};
+use std::fs::{self, File};
+use std::io::Read;
+use std::path::Path;
+
+const MAX_FILE_BYTES: u64 = 4096;
+const MIN_TOKEN_BYTES: usize = 32;
+const MAX_TOKEN_BYTES: usize = 1024;
+const REFUSED: &str = "peer credential unavailable or invalid";
+
+/// Read a provisioned peer token from an existing owner-private file.
+///
+/// Tokens contain 32–1024 ASCII graphic bytes, optionally followed by one LF or
+/// CRLF. The complete file is limited to 4096 bytes. Generate strong random
+/// credentials separately; this reader does not create files or repair access.
+///
+/// # Errors
+/// Returns a sanitized error for missing files, unsafe paths, nonprivate access,
+/// changed file identity or metadata, failed reads and invalid token content.
+pub fn read_peer_token(path: &Path) -> Result<String> {
+    read_private_token(path).map_err(|_| anyhow!(REFUSED))
+}
+
+fn unchanged(before: &fs::Metadata, after: &fs::Metadata) -> Result<()> {
+    if before.len() != after.len() || before.modified()? != after.modified()? {
+        bail!(REFUSED);
+    }
+    Ok(())
+}
+
+fn read_private_token(path: &Path) -> Result<String> {
+    let mut file = crate::outbox_private::open_existing_private(path)?;
+    crate::outbox_private::validate_identity(&file, path)?;
+    let before = file.metadata()?;
+    if before.len() > MAX_FILE_BYTES {
+        bail!(REFUSED);
+    }
+    let mut bytes = Vec::with_capacity(usize::try_from(before.len())?);
+    (&mut file).take(MAX_FILE_BYTES).read_to_end(&mut bytes)?;
+    crate::outbox_private::validate_identity(&file, path)?;
+    unchanged(&before, &file.metadata()?)?;
+    let verified: File = crate::outbox_private::open_existing_private(path)?;
+    crate::outbox_private::validate_identity(&file, path)?;
+    crate::outbox_private::validate_identity(&verified, path)?;
+    unchanged(&before, &verified.metadata()?)?;
+    unchanged(&before, &file.metadata()?)?;
+    if u64::try_from(bytes.len())? != before.len() {
+        bail!(REFUSED);
+    }
+    decode_token(&bytes)
+}
+
+fn decode_token(bytes: &[u8]) -> Result<String> {
+    let token = bytes
+        .strip_suffix(b"\r\n")
+        .or_else(|| bytes.strip_suffix(b"\n"))
+        .unwrap_or(bytes);
+    if !(MIN_TOKEN_BYTES..=MAX_TOKEN_BYTES).contains(&token.len())
+        || !token.iter().all(u8::is_ascii_graphic)
+    {
+        bail!(REFUSED);
+    }
+    Ok(String::from_utf8(token.to_vec())?)
+}
