+    let pending_at: i64 = redis::cmd("PEXPIRETIME")
+        .arg(&pending_key)
+        .query_async(&mut redis)
+        .await
+        .unwrap();
+    let deadline_at: i64 = redis::cmd("PEXPIRETIME")
+        .arg(&deadline_key)
+        .query_async(&mut redis)
+        .await
+        .unwrap();
+    let created = crate::postgres_store::parse_timestamp_utc(&a.timestamp_utc).unwrap();
+    assert_eq!(pending_at, created.timestamp_millis() + 300_000);
+    assert_eq!(deadline_at, created.timestamp_millis() + 120_000);
+    let raw: String = redis::cmd("GET")
+        .arg(&deadline_key)
+        .query_async(&mut redis)
+        .await
+        .unwrap();
+    let deadline: crate::models::AckDeadline = serde_json::from_str(&raw).unwrap();
+    assert_eq!(deadline.message_id, a.id);
+    assert_eq!(deadline.recipient, a.to);
+    assert_eq!(
+        crate::postgres_store::parse_timestamp_utc(&deadline.deadline_at).unwrap(),
+        created + chrono::Duration::seconds(120)
+    );
+    let repeated = store
+        .project_posted(&mut redis, &settings, &a_event)
+        .await
+        .unwrap();
+    assert_eq!(repeated.message.id, a.id);
+    let retry_pending: i64 = redis::cmd("PEXPIRETIME")
+        .arg(&pending_key)
+        .query_async(&mut redis)
+        .await
+        .unwrap();
+    let retry_deadline: i64 = redis::cmd("PEXPIRETIME")
+        .arg(&deadline_key)
+        .query_async(&mut redis)
+        .await
+        .unwrap();
+    assert_eq!((pending_at, deadline_at), (retry_pending, retry_deadline));
+    // The existing public read operations must consume the new records.
+    let read_settings = settings.clone();
+    let expected_id = a.id.clone();
+    let recipient = a.to;
+    std::thread::spawn(move || {
+        let pending =
+            crate::redis_bus::list_pending_acks(&read_settings, Some(&recipient)).unwrap();
+        assert!(pending.iter().any(|entry| entry.message_id == expected_id));
+        let deadlines = crate::ops::ack_deadline::list_ack_deadlines(&read_settings).unwrap();
+        assert!(
