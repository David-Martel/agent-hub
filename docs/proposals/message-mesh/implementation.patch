+/// Explicit communication allowlist; newly added commands retain old routing.
+fn command_uses_local_messages(command: &Cmd) -> bool {
+    matches!(
+        command,
+        Cmd::Health { .. }
+            | Cmd::Send { .. }
+            | Cmd::Read { .. }
+            | Cmd::Watch { .. }
+            | Cmd::Ack { .. }
+            | Cmd::Presence { .. }
+            | Cmd::PresenceList { .. }
+            | Cmd::PresenceHistory { .. }
+            | Cmd::PendingAcks { .. }
+            | Cmd::Monitor { .. }
+            | Cmd::BatchSend { .. }
+            | Cmd::PostDirect { .. }
+            | Cmd::ReadDirect { .. }
+            | Cmd::PostGroup { .. }
+            | Cmd::ReadGroup { .. }
+            | Cmd::Knock { .. }
+            | Cmd::SessionSummary { .. }
+            | Cmd::TokenCount { .. }
+            | Cmd::CompactContext { .. }
+            | Cmd::SummarizeThread { .. }
+            | Cmd::CompactThread { .. }
+            | Cmd::PushTask { .. }
+            | Cmd::PullTask { .. }
+            | Cmd::PeekTasks { .. }
+            | Cmd::Subscribe { .. }
+            | Cmd::Unsubscribe { .. }
+            | Cmd::Subscriptions { .. }
+            | Cmd::ThreadCreate { .. }
+            | Cmd::ThreadJoin { .. }
+            | Cmd::ThreadLeave { .. }
+            | Cmd::ThreadList { .. }
+            | Cmd::ThreadClose { .. }
+            | Cmd::OverdueAcks { .. }
+    )
+}
+
+fn command_settings(original: &settings::Settings, command: &Cmd) -> settings::Settings {
+    if original.local_messages
+        && (command_uses_local_messages(command)
+            || (matches!(
+                command,
+                Cmd::Claim { .. }
+                    | Cmd::RenewClaim { .. }
+                    | Cmd::ReleaseClaim { .. }
+                    | Cmd::Resolve { .. }
+            ) && original.mesh.is_some()
+                && original.require_claim_authority().is_ok()))
+    {
+        original.local_message_settings()
+    } else {
+        original.clone()
+    }
+}
+
+fn local_claim_requires_authority(settings: &settings::Settings, command: &Cmd) -> bool {
+    settings.local_messages
+        && !(settings.mesh.is_some() && settings.require_claim_authority().is_ok())
+        && matches!(
+            command,
+            Cmd::Claim { .. }
+                | Cmd::RenewClaim { .. }
+                | Cmd::ReleaseClaim { .. }
+                | Cmd::Resolve { .. }
+        )
+        && !settings.effective_hub_candidates().iter().any(|candidate| {
+            candidate.role == agent_bus_core::hub_candidates::HubRole::Authoritative
+        })
+}
