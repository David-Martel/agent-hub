+        }
+        let healthy = Server::start(false, false).await;
+        let mut urls: Vec<_> = stalled.iter().map(|server| server.url.clone()).collect();
+        urls.push(healthy.url.clone());
+        let source = source();
+        let config = PeerConfig::with_urls(
+            "source".to_owned(),
+            "destination".to_owned(),
+            "fixture".to_owned(),
+            &urls,
+            BearerToken::new("synthetic-peer-fixture"),
+            false,
+        )
+        .unwrap();
+        let worker = PeerWorker::with_timing(config, source.clone(), quick_timing()).unwrap();
+        let status = Arc::clone(&worker.status);
+        let (stop, stopped) = watch::channel(false);
+        let task = tokio::spawn(worker.run(stopped));
+        tokio::time::timeout(Duration::from_secs(4), async {
+            while source.position("destination") != 2 {
+                tokio::time::sleep(Duration::from_millis(10)).await;
+            }
+        })
+        .await
+        .unwrap();
+        stop.send(true).unwrap();
+        tokio::time::timeout(Duration::from_secs(2), task)
+            .await
+            .unwrap()
+            .unwrap();
+        assert!(status.lock().unwrap().failures >= 2);
+        assert_eq!(healthy.receiver.store.0.lock().unwrap().rows.len(), 2);
+        for server in stalled {
+            server.receiver.release.as_ref().unwrap().notify_waiters();
+            server.finish().await;
+        }
+        healthy.finish().await;
+    }
