+async fn validate_owned_fixture(settings: &Settings) {
+    use tokio::io::{AsyncReadExt, AsyncWriteExt};
+    let run_id =
+        std::env::var("AGENT_BUS_TEST_RUN_ID").expect("owned harness run identity required");
+    assert!((8..=48).contains(&run_id.len()));
+    assert!(
+        run_id
+            .bytes()
+            .all(|b| b.is_ascii_lowercase() || b.is_ascii_digit() || b == b'_')
+    );
+    let database = url::Url::parse(settings.database_url.as_deref().unwrap()).unwrap();
+    assert_eq!(database.path(), format!("/agent_bus_test_{run_id}"));
+    let redis = url::Url::parse(&settings.redis_url).unwrap();
+    let server =
+        url::Url::parse(&std::env::var("AGENT_BUS_TEST_SERVER_URL").expect("owned HTTP required"))
+            .unwrap();
+    for endpoint in [&database, &redis, &server] {
+        assert_eq!(endpoint.host_str(), Some("localhost"));
+        let port = endpoint.port().expect("explicit disposable port required");
+        assert!(port >= 1024 && ![6379, 6380, 5432, 5300, 8400, 8401, 18400].contains(&port));
+        assert!(endpoint.query().is_none() && endpoint.fragment().is_none());
+    }
+    assert_eq!(server.scheme(), "http");
+    let token = std::env::var("AGENT_BUS_TEST_AUTH_TOKEN").expect("owned HTTP token required");
+    assert!(token.len() >= 16 && !token.contains(['\r', '\n']));
+    // Read-only owned-service identity check precedes schema/data mutations.
+    let body = tokio::time::timeout(Duration::from_secs(3),async {
+        let address = std::net::SocketAddr::from(([127,0,0,1],server.port().unwrap()));
+        let mut socket = tokio::net::TcpStream::connect(address).await.unwrap();
+        socket.write_all(format!("GET /health HTTP/1.0\r\nHost: localhost\r\nAuthorization: Bearer {token}\r\nConnection: close\r\n\r\n").as_bytes()).await.unwrap();
+        let mut response = Vec::new();
+        socket.take(1024*1024).read_to_end(&mut response).await.unwrap();
+        let split = response.windows(4).position(|w|w==b"\r\n\r\n").expect("owned HTTP response headers required");
+        assert!(response.starts_with(b"HTTP/1.0 200") || response.starts_with(b"HTTP/1.1 200"));
+        serde_json::from_slice::<Value>(&response[split+4..]).expect("owned health JSON required")
+    }).await.expect("owned health deadline");
+    assert_eq!(
+        body["maintenance"]["service_agent_id"],
+        format!("agent-bus-test-{run_id}")
+    );
+    assert_eq!(body["ok"], true);
+    assert_eq!(body["database_ok"], true);
+    assert_eq!(body["storage_ready"], true);
+    for (field, expected) in [("redis_url", redis), ("database_url", database)] {
+        let actual = url::Url::parse(
+            body[field]
+                .as_str()
+                .expect("owned backend identity required"),
+        )
+        .unwrap();
+        assert_eq!(
+            (
+                actual.scheme(),
+                actual.host_str(),
+                actual.port(),
+                actual.path()
+            ),
+            (
+                expected.scheme(),
+                expected.host_str(),
+                expected.port(),
+                expected.path()
+            )
+        );
+    }
+}
