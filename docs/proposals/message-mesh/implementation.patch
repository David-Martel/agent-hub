+//! Own mesh peer admission, authenticated import and local projection workers.
+
+use std::collections::BTreeMap;
+use std::net::{IpAddr, Ipv4Addr, Ipv6Addr, SocketAddr};
+use std::path::Path;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Arc, Mutex, RwLock as AuthLock};
+use std::time::Duration;
+
+use agent_bus_core::hub_candidates::BearerToken;
+use agent_bus_core::mesh_capture::{CaptureConfig, parse_config};
+use agent_bus_core::mesh_store::{MeshStore, ProjectionHealth, ProjectionSweep, valid_identity};
+use agent_bus_core::ops::admin::ServerControlStatus;
+use agent_bus_core::peer_credentials::read_peer_token;
+use agent_bus_core::settings::Settings;
+use anyhow::{Result, anyhow};
+use axum::body::to_bytes;
+use axum::extract::{Request, State};
+use axum::http::StatusCode;
+use axum::response::{IntoResponse, Response};
+use axum::routing::post;
+use axum::{Json, Router};
+use serde::Serialize;
+use tokio::sync::{RwLock, Semaphore, watch};
+use tokio::task::{JoinHandle, JoinSet};
+
+use crate::peer_sync::{
+    MAX_BATCH, MAX_BODY_BYTES, MeshBatch, MeshPeerSettings, PeerConfig, PeerStatus, PeerWorker,
+    PgStore, Store, SyncError, authenticate_peer, receive,
+};
+
+const DATABASE_BUDGET: Duration = Duration::from_secs(5);
+const PROJECTION_BUDGET: Duration = Duration::from_secs(5);
+const BODY_BUDGET: Duration = Duration::from_secs(5);
+const POLL: Duration = Duration::from_secs(2);
+
+#[derive(Debug, Clone, Copy, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub(crate) enum PeerState {
+    ConfigBlocked,
+    CredentialBlocked,
+    RouteBlocked,
+    Registering,
+    Running,
+    Paused,
+    Stopped,
+}
+
+#[derive(Debug, Clone, Serialize)]
+pub(crate) struct PeerHealth {
+    pub(crate) hub: String,
+    pub(crate) state: PeerState,
+    pub(crate) inbound_ready: bool,
+    pub(crate) retries: u64,
+    pub(crate) last_error: Option<SyncError>,
+    pub(crate) traffic: PeerStatus,
+}
+
+#[derive(Debug, Default, Clone, Serialize)]
+pub(crate) struct ProjectionStatus {
+    pub(crate) paused: bool,
+    pub(crate) last_error: Option<SyncError>,
+    pub(crate) cleanup_failures: u64,
+    pub(crate) last_sweep: Option<ProjectionSweep>,
+    pub(crate) backlog: Option<ProjectionHealth>,
+}
+
+#[derive(Debug, Clone, Serialize)]
+pub(crate) struct Status {
+    pub(crate) local_hub: String,
+    pub(crate) scope: String,
+    pub(crate) claim_authority: String,
+    pub(crate) peers: Vec<PeerHealth>,
+    pub(crate) projection: ProjectionStatus,
+}
+
+#[derive(Clone)]
+struct PeerSlot(Arc<Mutex<PeerHealth>>);
+
+impl PeerSlot {
+    fn set(&self, state: PeerState, error: Option<SyncError>) {
+        let mut health = self
+            .0
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        health.state = state;
+        health.last_error = error;
+        if error.is_some() {
+            health.retries = health.retries.saturating_add(1);
+        }
+    }
+}
+
+struct Shared<S> {
+    store: S,
+    capture: CaptureConfig,
+    control: Arc<RwLock<ServerControlStatus>>,
+    inbound: AuthLock<BTreeMap<String, BearerToken>>,
+    ingress: Arc<Semaphore>,
+    peers: Vec<PeerSlot>,
+    projection: Mutex<ProjectionStatus>,
+    stopping: AtomicBool,
+    stop_signal: watch::Receiver<bool>,
+}
+
+/// Cloneable HTTP state; status reads never call backends or peers.
+#[derive(Clone)]
+pub(crate) struct App<S = PgStore>(Arc<Shared<S>>);
+
+impl<S: Store> App<S> {
+    fn is_stopping(&self) -> bool {
+        self.0.stopping.load(Ordering::Acquire) || *self.0.stop_signal.borrow()
+    }
+
+    pub(crate) fn router(&self) -> Router {
+        Router::new()
+            .route("/mesh/messages", post(import_messages::<S>))
+            .with_state(self.clone())
+    }
+
+    pub(crate) fn status(&self) -> Status {
+        Status {
+            local_hub: self.0.capture.hub.clone(),
+            scope: self.0.capture.scope.clone(),
+            claim_authority: self.0.capture.claim_authority.clone(),
+            peers: self
+                .0
+                .peers
+                .iter()
+                .map(|slot| {
+                    slot.0
+                        .lock()
+                        .unwrap_or_else(std::sync::PoisonError::into_inner)
+                        .clone()
+                })
+                .collect(),
+            projection: self
+                .0
+                .projection
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner)
+                .clone(),
+        }
+    }
+}
+
+/// Keep this owner alive and call shutdown before releasing the HTTP service.
+pub(crate) struct Runtime {
+    pub(crate) app: App,
+    stop: watch::Sender<bool>,
+    tasks: JoinSet<()>,
+}
+
+impl Runtime {
+    /// Signal this sender before waiting for HTTP/SSE drain, then join explicitly.
+    pub(crate) fn stop_handle(&self) -> watch::Sender<bool> {
+        self.stop.clone()
+    }
+
+    /// Signal every worker and await its owned connection-driver cleanup.
+    pub(crate) async fn shutdown(mut self) -> Result<()> {
+        self.app.0.stopping.store(true, Ordering::Release);
+        let _ = self.stop.send(true);
+        let mut failed = false;
+        while let Some(result) = self.tasks.join_next().await {
+            failed |= result.is_err();
+        }
+        if failed {
+            return Err(anyhow!("mesh worker settlement failed"));
+        }
+        Ok(())
+    }
+}
+
+impl Drop for Runtime {
+    fn drop(&mut self) {
+        self.app.0.stopping.store(true, Ordering::Release);
+        let _ = self.stop.send(true);
+    }
+}
+
+/// Start only after listener admission; no peer failure gates local HTTP service.
+pub(crate) fn start(
+    settings: Arc<Settings>,
+    control: Arc<RwLock<ServerControlStatus>>,
+) -> Result<Option<Runtime>> {
+    let Some(capture) =
+        parse_config(&settings).map_err(|_| anyhow!("invalid mesh global configuration"))?
+    else {
+        return Ok(None);
+    };
+    tokio::runtime::Handle::try_current()
+        .map_err(|_| anyhow!("mesh requires an active async runtime"))?;
+    let values = settings
+        .mesh
+        .as_ref()
+        .and_then(|value| value.get("peers"))
+        .map(|value| serde_json::from_value::<Vec<serde_json::Value>>(value.clone()))
+        .transpose()
+        .map_err(|_| anyhow!("invalid mesh peer inventory"))?
+        .unwrap_or_default();
+    if values.len() > 16 {
+        return Err(anyhow!("mesh peer inventory exceeds bound"));
+    }
+    let parsed: Vec<Option<MeshPeerSettings>> = values
+        .into_iter()
+        .map(|value| serde_json::from_value(value).ok())
+        .collect();
+    let mut counts = BTreeMap::<String, usize>::new();
+    for peer in parsed.iter().flatten() {
+        *counts.entry(peer.hub.clone()).or_default() += 1;
+    }
+    let peers: Vec<PeerSlot> = parsed
+        .iter()
+        .enumerate()
+        .map(|(index, peer)| {
+            let hub = peer
+                .as_ref()
+                .filter(|peer| valid_identity(&peer.hub))
+                .map_or_else(|| format!("invalid-peer-{index}"), |peer| peer.hub.clone());
+            PeerSlot(Arc::new(Mutex::new(PeerHealth {
+                hub,
+                state: PeerState::ConfigBlocked,
+                inbound_ready: false,
+                retries: 0,
+                last_error: Some(SyncError::Configuration),
+                traffic: PeerStatus::default(),
+            })))
+        })
+        .collect();
+    let (stop, receiver) = watch::channel(false);
+    let app = App(Arc::new(Shared {
+        store: PgStore::new(Arc::clone(&settings), capture.scope.clone(), capture.limits),
+        capture,
+        control,
+        inbound: AuthLock::new(BTreeMap::new()),
+        ingress: Arc::new(Semaphore::new(8)),
+        peers,
+        projection: Mutex::new(ProjectionStatus::default()),
+        stopping: AtomicBool::new(false),
+        stop_signal: receiver.clone(),
+    }));
+    let mut tasks = JoinSet::new();
+    for (index, peer) in parsed.into_iter().enumerate() {
+        let Some(peer) = peer else {
+            continue;
+        };
+        if !valid_identity(&peer.hub)
+            || peer.hub == app.0.capture.hub
+            || counts.get(&peer.hub) != Some(&1)
+        {
+            continue;
+        }
+        tasks.spawn(peer_loop(
+            Arc::clone(&settings),
+            app.clone(),
+            peer,
+            app.0.peers[index].clone(),
+            receiver.clone(),
+        ));
+    }
+    tasks.spawn(projection_loop(settings, app.clone(), receiver));
+    Ok(Some(Runtime { app, stop, tasks }))
+}
+
+async fn wait(stop: &mut watch::Receiver<bool>, delay: Duration) -> bool {
+    if *stop.borrow() {
+        return false;
+    }
+    tokio::select! {
+        () = tokio::time::sleep(delay) => true,
+        result = stop.changed() => result.is_ok() && !*stop.borrow(),
+    }
+}
+
+fn retry_delay(failures: u32) -> Duration {
+    let jitter = u64::from(uuid::Uuid::new_v4().as_bytes()[0]) * 4;
+    Duration::from_secs(1_u64 << failures.min(5)) + Duration::from_millis(jitter)
+}
+
+async fn register_peer(
+    settings: &Settings,
+    capture: &CaptureConfig,
+    peer: &str,
+) -> Result<(), SyncError> {
+    let mut store = MeshStore::connect(settings, &capture.scope, capture.limits)
+        .await
+        .map_err(|_| SyncError::Store)?;
+    let result = tokio::time::timeout(DATABASE_BUDGET, store.register_peer(peer))
+        .await
+        .map_err(|_| SyncError::Store)
+        .and_then(|value| value.map_err(|_| SyncError::Store));
+    let closed = store.close().await.map_err(|_| SyncError::Store);
+    result?;
+    closed
+}
+
+async fn peer_loop(
+    settings: Arc<Settings>,
+    app: App,
+    peer: MeshPeerSettings,
+    slot: PeerSlot,
+    mut stop: watch::Receiver<bool>,
+) {
+    let mut failures = 0_u32;
+    while !*stop.borrow() {
+        if app.0.control.read().await.write_blocked {
+            slot.set(PeerState::Paused, None);
+            if !wait(&mut stop, POLL).await {
+                break;
+            }
+            continue;
+        }
+        let inbound = read_peer_token(Path::new(&peer.inbound_token_file));
+        let ready = inbound.is_ok();
+        {
+            let mut keys = app
+                .0
+                .inbound
+                .write()
+                .unwrap_or_else(std::sync::PoisonError::into_inner);
+            if let Ok(token) = inbound {
+                keys.insert(peer.hub.clone(), BearerToken::new(token));
+            } else {
+                keys.remove(&peer.hub);
+            }
+        }
+        slot.0
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .inbound_ready = ready;
+        let worker = read_peer_token(Path::new(&peer.outbound_token_file))
+            .map_err(|_| PeerState::CredentialBlocked)
+            .and_then(|token| {
+                PeerConfig::with_urls(
+                    app.0.capture.hub.clone(),
+                    peer.hub.clone(),
+                    app.0.capture.scope.clone(),
+                    &peer.urls,
+                    BearerToken::new(token),
+                    peer.allow_private_http,
+                )
+                .map_err(|_| PeerState::RouteBlocked)
+            })
+            .and_then(|config| {
+                PeerWorker::new(config, app.0.store.clone()).map_err(|_| PeerState::RouteBlocked)
+            });
+        if let Ok(worker) = worker {
+            slot.set(PeerState::Registering, None);
+            if register_peer(&settings, &app.0.capture, &peer.hub)
+                .await
+                .is_ok()
+            {
+                loop {
+                    if *stop.borrow() {
+                        break;
+                    }
+                    if app.0.control.read().await.write_blocked {
+                        slot.set(PeerState::Paused, None);
+                        if !wait(&mut stop, POLL).await {
+                            break;
+                        }
+                        continue;
+                    }
+                    slot.set(PeerState::Running, None);
+                    let result = worker.push_once().await;
+                    let delay = match result {
+                        Ok(more) => {
+                            failures = 0;
+                            if more {
+                                Duration::from_millis(10)
+                            } else {
+                                POLL
+                            }
+                        }
+                        Err(error) => {
+                            slot.set(PeerState::Running, Some(error));
+                            let mut traffic = worker
+                                .status
+                                .lock()
+                                .unwrap_or_else(std::sync::PoisonError::into_inner);
+                            traffic.failures = traffic.failures.saturating_add(1);
+                            traffic.last_error = Some(error);
+                            drop(traffic);
+                            failures = failures.saturating_add(1);
+                            if matches!(error, SyncError::Identity | SyncError::UnknownPeer) {
+                                let observed = worker
+                                    .status
+                                    .lock()
+                                    .unwrap_or_else(std::sync::PoisonError::into_inner)
+                                    .clone();
+                                slot.0
+                                    .lock()
+                                    .unwrap_or_else(std::sync::PoisonError::into_inner)
+                                    .traffic = observed;
+                                break;
+                            }
+                            retry_delay(failures)
+                        }
+                    };
+                    slot.0
+                        .lock()
+                        .unwrap_or_else(std::sync::PoisonError::into_inner)
+                        .traffic = worker
+                        .status
+                        .lock()
+                        .unwrap_or_else(std::sync::PoisonError::into_inner)
+                        .clone();
+                    if !wait(&mut stop, delay).await {
+                        break;
+                    }
+                }
+            } else {
+                slot.set(PeerState::Registering, Some(SyncError::Store));
+            }
+        } else if let Err(state) = worker {
+            slot.set(state, Some(SyncError::Configuration));
+        }
+        failures = failures.saturating_add(1);
+        if !wait(&mut stop, retry_delay(failures)).await {
+            break;
+        }
+    }
+    slot.set(PeerState::Stopped, None);
+}
+
+fn failure(status: StatusCode, code: &'static str) -> Response {
+    (status, Json(serde_json::json!({"error":code}))).into_response()
+}
+
+async fn import_messages<S: Store>(State(app): State<App<S>>, request: Request) -> Response {
+    let authenticated = {
+        let keys = app
+            .0
+            .inbound
+            .read()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        authenticate_peer(request.headers(), &keys)
+    };
+    let Ok(peer) = authenticated else {
+        return failure(StatusCode::UNAUTHORIZED, "mesh_identity");
+    };
+    if app.is_stopping() || app.0.control.read().await.write_blocked {
+        return failure(StatusCode::SERVICE_UNAVAILABLE, "mesh_maintenance");
+    }
+    let Ok(_permit) = Arc::clone(&app.0.ingress).try_acquire_owned() else {
+        return failure(StatusCode::TOO_MANY_REQUESTS, "mesh_backpressure");
+    };
+    let bytes = match tokio::time::timeout(
+        BODY_BUDGET,
+        to_bytes(request.into_body(), MAX_BODY_BYTES),
+    )
+    .await
+    {
+        Ok(Ok(bytes)) => bytes,
+        Ok(Err(_)) => return failure(StatusCode::PAYLOAD_TOO_LARGE, "mesh_body_limit"),
+        Err(_) => return failure(StatusCode::REQUEST_TIMEOUT, "mesh_body_deadline"),
+    };
+    let Ok(batch) = serde_json::from_slice::<MeshBatch>(&bytes) else {
+        return failure(StatusCode::BAD_REQUEST, "mesh_invalid_batch");
+    };
+    if app.is_stopping() || app.0.control.read().await.write_blocked {
+        return failure(StatusCode::SERVICE_UNAVAILABLE, "mesh_maintenance");
+    }
+    match receive(
+        &app.0.store,
+        &peer,
+        &app.0.capture.hub,
+        &app.0.capture.scope,
+        batch,
+    )
+    .await
+    {
+        Ok(receipt) => Json(receipt).into_response(),
+        Err(error) => {
+            let status = match error {
+                SyncError::Identity => StatusCode::FORBIDDEN,
+                SyncError::Page | SyncError::Encode | SyncError::Configuration => {
+                    StatusCode::BAD_REQUEST
+                }
+                SyncError::Collision => StatusCode::CONFLICT,
+                SyncError::Backpressure | SyncError::Capacity => StatusCode::INSUFFICIENT_STORAGE,
+                _ => StatusCode::SERVICE_UNAVAILABLE,
+            };
+            failure(status, "mesh_import_refused")
+        }
+    }
+}
+
+struct OwnedRedis {
+    connection: Option<redis::aio::MultiplexedConnection>,
+    driver: Option<JoinHandle<()>>,
+}
+
+impl Drop for OwnedRedis {
+    fn drop(&mut self) {
+        if let Some(driver) = &self.driver {
+            driver.abort();
+        }
+    }
+}
+
+impl OwnedRedis {
+    async fn connect(settings: &Settings) -> Result<Self, SyncError> {
+        let client =
+            redis::Client::open(settings.redis_url.as_str()).map_err(|_| SyncError::Projection)?;
+        let redis::ConnectionAddr::Tcp(host, port) = &client.get_connection_info().addr else {
+            return Err(SyncError::Projection);
+        };
+        #[cfg(test)]
+        if [6379, 6380, 5432, 5300, 8400, 8401].contains(port) {
+            return Err(SyncError::Projection);
+        }
+        let addresses = if host.eq_ignore_ascii_case("localhost") {
+            vec![
+                IpAddr::V4(Ipv4Addr::LOCALHOST),
+                IpAddr::V6(Ipv6Addr::LOCALHOST),
+            ]
+        } else {
+            let address: IpAddr = host.parse().map_err(|_| SyncError::Projection)?;
+            if !address.is_loopback() {
+                return Err(SyncError::Projection);
+            }
+            vec![address]
+        };
+        let established = tokio::time::timeout(Duration::from_secs(2), async {
+            for address in addresses {
+                let stream = match tokio::time::timeout(
+                    Duration::from_millis(500),
+                    tokio::net::TcpStream::connect(SocketAddr::new(address, *port)),
+                )
+                .await
+                {
+                    Ok(Ok(stream)) => stream,
+                    _ => continue,
+                };
+                let config = redis::AsyncConnectionConfig::new()
+                    .set_response_timeout(Some(Duration::from_secs(2)));
+                if let Ok((connection, driver)) =
+                    redis::aio::MultiplexedConnection::new_with_config(
+                        &client.get_connection_info().redis,
+                        stream,
+                        config,
+                    )
+                    .await
+                {
+                    return Ok(Self {
+                        connection: Some(connection),
+                        driver: Some(tokio::spawn(driver)),
+                    });
+                }
+            }
+            Err(SyncError::Projection)
+        })
+        .await
+        .map_err(|_| SyncError::Projection)?;
+        established
+    }
+
+    async fn close(mut self) -> Result<(), SyncError> {
+        drop(self.connection.take());
+        let Some(driver) = self.driver.take() else {
+            return Ok(());
+        };
+        driver.abort();
+        match driver.await {
+            Ok(()) => Ok(()),
+            Err(error) if error.is_cancelled() => Ok(()),
+            Err(_) => Err(SyncError::Projection),
+        }
+    }
+}
+
+async fn projection_once(
+    settings: &Settings,
+    capture: &CaptureConfig,
+) -> (Result<(ProjectionSweep, ProjectionHealth), SyncError>, bool) {
+    let mut store = match MeshStore::connect(settings, &capture.scope, capture.limits).await {
+        Ok(store) => store,
+        Err(_) => return (Err(SyncError::Store), false),
+    };
+    let mut redis = match OwnedRedis::connect(settings).await {
+        Ok(redis) => redis,
+        Err(error) => {
+            let cleanup_failed = store.close().await.is_err();
+            return (Err(error), cleanup_failed);
+        }
+    };
+    let result = tokio::time::timeout(PROJECTION_BUDGET, async {
+        let connection = redis.connection.as_mut().ok_or(SyncError::Projection)?;
+        let sweep = store
+            .repair_pending(
+                connection,
+                settings,
+                MAX_BATCH.min(capture.limits.max_batch),
+            )
+            .await
+            .map_err(|_| SyncError::Projection)?;
+        let health = store
+            .projection_health()
+            .await
+            .map_err(|_| SyncError::Store)?;
+        Ok((sweep, health))
+    })
+    .await
+    .map_err(|_| SyncError::Projection)
+    .and_then(std::convert::identity);
+    let redis_closed = redis.close().await;
+    let pg_closed = store.close().await.map_err(|_| SyncError::Store);
+    let cleanup_failed = redis_closed.is_err() || pg_closed.is_err();
+    let result = result.and_then(|value| redis_closed.and(pg_closed).map(|()| value));
+    (result, cleanup_failed)
+}
+
+async fn projection_loop(settings: Arc<Settings>, app: App, mut stop: watch::Receiver<bool>) {
+    while !*stop.borrow() {
+        let paused = app.0.control.read().await.write_blocked;
+        if paused {
+            app.0
+                .projection
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner)
+                .paused = true;
+        } else {
+            let (result, cleanup_failed) = projection_once(&settings, &app.0.capture).await;
+            let mut status = app
+                .0
+                .projection
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner);
+            status.paused = false;
+            if cleanup_failed {
+                status.cleanup_failures = status.cleanup_failures.saturating_add(1);
+            }
+            match result {
+                Ok((sweep, health)) => {
+                    status.last_sweep = Some(sweep);
+                    status.backlog = Some(health);
+                    status.last_error = None;
+                }
+                Err(error) => status.last_error = Some(error),
+            }
+        }
+        if !wait(&mut stop, POLL).await {
+            break;
+        }
+    }
+}
