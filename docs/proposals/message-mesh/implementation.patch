+    fn fixture(bytes: &[u8]) -> (tempfile::TempDir, PathBuf) {
+        let root = tempfile::tempdir().unwrap();
+        let parent = root.path().join("private");
+        crate::outbox_private::create_directory(&parent).unwrap();
+        let path = parent.join("peer.token");
+        let mut file = crate::outbox_private::open(&path).unwrap();
+        file.write_all(bytes).unwrap();
+        file.sync_all().unwrap();
+        drop(file);
+        (root, path)
+    }
+
+    fn assert_refused(path: &Path) {
+        let error = read_peer_token(path)
+            .err()
+            .expect("credential must be refused");
+        assert_eq!(error.to_string(), REFUSED);
+        assert_eq!(error.chain().count(), 1);
+    }
+
