+//! Bridge synchronous local message APIs to bounded durable mesh capture.
+//!
+//! Peer traffic and client journals are absent. Generated identities are fixed
+//! before the worker starts; ambiguous commit or projection errors carry those
+//! identities and explicitly forbid resubmission under a new ID.
+
+use std::fmt;
+use std::future::Future;
+use std::time::Duration;
+
+use serde::Serialize;
+use serde_json::{Value, json};
+
+use crate::mesh_store::{Limits, MeshError, MeshEvent, MeshStore, MeshTarget};
+use crate::models::Message;
+use crate::outbox::{Operation, ReplayRequest};
+use crate::redis_bus::{PostedMessage, prepare_message};
+use crate::settings::Settings;
+
+const CAPTURE_BUDGET: Duration = Duration::from_secs(5);
+const PROJECTION_BUDGET: Duration = Duration::from_secs(5);
+const REPLAY_FINGERPRINT: &str = "_agent_bus_mesh_replay_fingerprint";
+
+/// Sanitized custody classification; no payloads or credentials are displayed.
+#[derive(Debug, Clone, Copy, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub enum CaptureFailureKind {
+    Invalid,
+    Collision,
+    CapacityNotRetained,
+    WorkerNotStarted,
+    StoreUnavailableNotRetained,
+    CommitUncertain,
+    CapturedProjectionPending,
+}
+
+impl fmt::Display for CaptureFailureKind {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(formatter, "mesh capture {self:?}")
+    }
+}
+
+impl std::error::Error for CaptureFailureKind {}
+
+/// Preserve original identities for exact retry and durable status inspection.
+#[derive(Debug, Serialize)]
+pub struct CaptureFailure {
+    pub kind: CaptureFailureKind,
+    pub message_ids: Vec<String>,
+}
+
+impl fmt::Display for CaptureFailure {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        let disposition = match self.kind {
+            CaptureFailureKind::Invalid => "mesh capture invalid; not accepted",
+            CaptureFailureKind::Collision => "mesh immutable identity collision; preserve state",
+            CaptureFailureKind::CapacityNotRetained => {
+                "mesh capacity full; new capture not retained"
+            }
+            CaptureFailureKind::WorkerNotStarted => {
+                "mesh capture worker did not start; no capture attempted"
+            }
+            CaptureFailureKind::StoreUnavailableNotRetained => {
+                "mesh durable store unavailable; no event capture attempted"
+            }
+            CaptureFailureKind::CommitUncertain => {
+                "mesh capture durability uncertain; preserve original request"
+            }
+            CaptureFailureKind::CapturedProjectionPending => {
+                "mesh durable capture retained; local projection pending"
+            }
+        };
+        write!(
+            formatter,
+            "{disposition}; message_ids={:?}; retry only the exact immutable request, never a new message ID",
+            self.message_ids
+        )
+    }
+}
+
+impl std::error::Error for CaptureFailure {}
+pub type CaptureResult<T> = Result<T, CaptureFailure>;
+
+#[derive(Debug, Clone)]
+pub struct CaptureConfig {
+    pub scope: String,
+    pub hub: String,
+    pub claim_authority: String,
+    pub limits: Limits,
+}
+
+#[derive(Debug, serde::Deserialize)]
+struct RawConfig {
+    scope: String,
+    claim_authority: String,
+    limits: Option<RawLimits>,
+}
+
+#[derive(Debug, Default, serde::Deserialize)]
+#[serde(deny_unknown_fields)]
+struct RawLimits {
+    max_events: Option<i64>,
+    max_payload_bytes: Option<i64>,
+    max_batch: Option<usize>,
+}
+
+/// Validate global local-capture identity and bounds without opening peer tokens.
+///
+/// # Errors
+/// Invalid global fields fail closed. Peer admission is independently owned;
+/// malformed/offline peers do not prevent this local configuration from working.
+pub fn parse_config(settings: &Settings) -> Result<Option<CaptureConfig>, CaptureFailureKind> {
+    let Some(mesh) = &settings.mesh else {
+        return Ok(None);
+    };
+    let raw: RawConfig =
+        serde_json::from_value(mesh.clone()).map_err(|_| CaptureFailureKind::Invalid)?;
+    if !crate::mesh_store::valid_identity(&raw.scope)
+        || !crate::mesh_store::valid_identity(&raw.claim_authority)
+    {
+        return Err(CaptureFailureKind::Invalid);
+    }
+    let hub = settings
+        .hub_identity
+        .as_deref()
+        .filter(|hub| crate::mesh_store::valid_identity(hub))
+        .ok_or(CaptureFailureKind::Invalid)?;
+    let raw_limits = raw.limits.unwrap_or_default();
+    let defaults = Limits::default();
+    let limits = Limits {
+        max_events: raw_limits.max_events.unwrap_or(defaults.max_events),
+        max_payload_bytes: raw_limits
+            .max_payload_bytes
+            .unwrap_or(defaults.max_payload_bytes),
+        max_batch: raw_limits.max_batch.unwrap_or(defaults.max_batch),
+    };
+    if limits.max_events <= 0
+        || limits.max_payload_bytes <= 0
+        || !(1..=500).contains(&limits.max_batch)
+    {
+        return Err(CaptureFailureKind::Invalid);
+    }
+    Ok(Some(CaptureConfig {
+        scope: raw.scope,
+        hub: hub.to_owned(),
+        claim_authority: raw.claim_authority,
+        limits,
+    }))
+}
+
+fn failure(kind: CaptureFailureKind, message_ids: &[String]) -> CaptureFailure {
+    CaptureFailure {
+        kind,
+        message_ids: message_ids.to_owned(),
+    }
+}
+
+fn capture_error(error: MeshError) -> CaptureFailureKind {
+    match error {
+        MeshError::Invalid => CaptureFailureKind::Invalid,
+        MeshError::Collision => CaptureFailureKind::Collision,
+        MeshError::Backpressure => CaptureFailureKind::CapacityNotRetained,
+        _ => CaptureFailureKind::CommitUncertain,
+    }
+}
+
+/// Pure local admission preparation; never regenerates message IDs or time.
+fn prepare_items(
+    config: &CaptureConfig,
+    items: &mut [(MeshTarget, Message)],
+) -> Result<(), CaptureFailureKind> {
+    if items.is_empty() || items.len() > config.limits.max_batch {
+        return Err(CaptureFailureKind::Invalid);
+    }
+    for (target, message) in items {
+        crate::validation::non_empty(&message.body, "body")
+            .map_err(|_| CaptureFailureKind::Invalid)?;
+        if message
+            .origin_hub
+            .as_deref()
+            .is_some_and(|origin| origin != config.hub)
+        {
+            return Err(CaptureFailureKind::Invalid);
+        }
+        message.origin_hub = Some(config.hub.clone());
+        message.stream_id = None;
+        crate::mesh_store::target_payload_sha256(target, message).map_err(capture_error)?;
+    }
+    Ok(())
+}
+
+fn scoped_runtime<T, F, Fut>(message_ids: &[String], operation: F) -> CaptureResult<T>
+where
+    T: Send,
+    F: FnOnce() -> Fut + Send,
+    Fut: Future<Output = CaptureResult<T>>,
+{
+    std::thread::scope(|scope| {
+        let worker = std::thread::Builder::new()
+            .name("mesh-local-capture".to_owned())
+            .spawn_scoped(scope, move || {
+                let runtime = tokio::runtime::Builder::new_current_thread()
+                    .enable_all()
+                    .build()
+                    .map_err(|_| failure(CaptureFailureKind::WorkerNotStarted, message_ids))?;
+                let result = runtime.block_on(operation());
+                // All explicitly owned PG drivers were closed/joined before
+                // this point. Dropping this owned runtime settles its Redis
+                // driver's async tasks before the scoped thread is joined.
+                drop(runtime);
+                result
+            })
+            .map_err(|_| failure(CaptureFailureKind::WorkerNotStarted, message_ids))?;
+        worker
+            .join()
+            .map_err(|_| failure(CaptureFailureKind::CommitUncertain, message_ids))?
+    })
+}
+
+/// Capture an atomic local batch, then independently project its committed events.
+///
+/// # Errors
+/// Invalid/capacity failures are unretained. Ambiguous commits and retained but
+/// pending projection report stable identities; they never suggest a new ID.
+pub fn capture_messages(
+    settings: &Settings,
+    mut items: Vec<(MeshTarget, Message)>,
+) -> CaptureResult<Vec<PostedMessage>> {
+    let ids: Vec<_> = items
+        .iter()
+        .map(|(_, message)| message.id.clone())
+        .collect();
+    let configuration = parse_config(settings)
+        .map_err(|kind| failure(kind, &ids))?
+        .ok_or_else(|| failure(CaptureFailureKind::Invalid, &ids))?;
+    prepare_items(&configuration, &mut items).map_err(|kind| failure(kind, &ids))?;
+    scoped_runtime(&ids, || {
+        capture_async(settings, &configuration, items, &ids)
+    })
+}
+
+async fn capture_async(
+    settings: &Settings,
+    config: &CaptureConfig,
+    items: Vec<(MeshTarget, Message)>,
+    ids: &[String],
+) -> CaptureResult<Vec<PostedMessage>> {
+    // connect owns its two-second startup budget and failure-driver cleanup.
+    let mut store = MeshStore::connect(settings, &config.scope, config.limits)
+        .await
+        .map_err(|error| {
+            failure(
+                if matches!(error, MeshError::Invalid) {
+                    CaptureFailureKind::Invalid
+                } else {
+                    CaptureFailureKind::StoreUnavailableNotRetained
+                },
+                ids,
+            )
+        })?;
+    let captured = tokio::time::timeout(CAPTURE_BUDGET, store.append_batch_target(&items)).await;
+    let captured = match captured {
+        Ok(Ok(outcomes)) => outcomes,
+        result => {
+            let kind = match result {
+                Ok(Err(error)) => capture_error(error),
+                _ => CaptureFailureKind::CommitUncertain,
+            };
+            let _closed = store.close().await;
+            return Err(failure(kind, ids));
+        }
+    };
+    if captured.len() != items.len() {
+        let _closed = store.close().await;
+        return Err(failure(CaptureFailureKind::CommitUncertain, ids));
+    }
+    let projected = tokio::time::timeout(PROJECTION_BUDGET, async {
+        // Internal numeric loopback selection avoids blocking OS DNS. Saved
+        // configuration stays localhost. No peer URL or credential is used.
+        let addresses = crate::settings::loopback_url_candidates(&settings.redis_url)
+            .into_iter()
+            .filter(|candidate| {
+                url::Url::parse(candidate).is_ok_and(|url| {
+                    matches!(url.host(), Some(url::Host::Ipv4(ip)) if ip.is_loopback())
+                        || matches!(url.host(), Some(url::Host::Ipv6(ip)) if ip.is_loopback())
+                })
+            });
+        let mut connected = None;
+        for address in addresses {
+            crate::settings::refuse_live_bus_in_unit_tests(&address);
+            let client =
+                redis::Client::open(address).map_err(|_| MeshError::ProjectionUnavailable)?;
+            if let Ok(Ok(connection)) = tokio::time::timeout(
+                Duration::from_millis(500),
+                client.get_multiplexed_async_connection(),
+            )
+            .await
+            {
+                connected = Some(connection);
+                break;
+            }
+        }
+        let mut connection = connected.ok_or(MeshError::ProjectionUnavailable)?;
+        let mut posted = Vec::with_capacity(items.len());
+        for ((target, message), outcome) in items.into_iter().zip(captured) {
+            let hash = crate::mesh_store::target_payload_sha256(&target, &message)?;
+            let event = MeshEvent {
+                sequence: outcome.sequence,
+                target,
+                message,
+                payload_sha256: hash,
+            };
+            posted.push(
+                store
+                    .project_posted(&mut connection, settings, &event)
+                    .await?,
+            );
+        }
+        Ok::<_, MeshError>(posted)
+    })
+    .await;
+    let closed = store.close().await;
+    match (projected, closed) {
+        (Ok(Ok(posted)), Ok(())) => Ok(posted),
+        _ => Err(failure(CaptureFailureKind::CapturedProjectionPending, ids)),
+    }
+}
+
+/// Stable replay preparation independent of acceptance time or host session.
+///
+/// # Errors
+/// Rejects non-message operations, reserved provenance collisions and invalid inputs.
+pub fn replay_message(
+    settings: &Settings,
+    request: &ReplayRequest,
+) -> Result<Message, CaptureFailureKind> {
+    request
+        .validate()
+        .map_err(|_| CaptureFailureKind::Invalid)?;
+    if !matches!(request.operation, Operation::Send | Operation::Ack) {
+        return Err(CaptureFailureKind::Invalid);
+    }
+    let cfg = parse_config(settings)?.ok_or(CaptureFailureKind::Invalid)?;
+    let args = &request.arguments;
+    let text = |name: &str| args.get(name).and_then(Value::as_str);
+    let ack = request.operation == Operation::Ack;
+    let sender = text(if ack { "agent" } else { "sender" }).ok_or(CaptureFailureKind::Invalid)?;
+    let recipient = if ack {
+        "all"
+    } else {
+        text("recipient").ok_or(CaptureFailureKind::Invalid)?
+    };
+    let topic = if ack {
+        "ack"
+    } else {
+        text("topic").ok_or(CaptureFailureKind::Invalid)?
+    };
+    let body = text("body").unwrap_or(if ack { "ack" } else { "" });
+    let schema = if ack {
+        None
+    } else {
+        crate::validation::resolve_message_schema(request.surface.as_str(), text("schema"), topic)
+            .map_err(|_| CaptureFailureKind::Invalid)?
+    };
+    let fitted = if ack {
+        body.to_owned()
+    } else {
+        crate::validation::auto_fit_schema(
+            body,
+            schema.map(crate::validation::MessageSchema::as_str),
+        )
+    };
+    let tags: Vec<String> = if ack {
+        Vec::new()
+    } else {
+        args.get("tags")
+            .and_then(Value::as_array)
+            .into_iter()
+            .flatten()
+            .filter_map(Value::as_str)
+            .map(str::to_owned)
+            .collect()
+    };
+    let mut metadata = if ack {
+        json!({"ack_for":text("message_id").ok_or(CaptureFailureKind::Invalid)?})
+    } else {
+        args.get("metadata").cloned().unwrap_or_else(|| json!({}))
+    };
+    let object = metadata
+        .as_object_mut()
+        .ok_or(CaptureFailureKind::Invalid)?;
+    if object.contains_key(REPLAY_FINGERPRINT) {
+        return Err(CaptureFailureKind::Invalid);
+    }
+    object.insert(
+        REPLAY_FINGERPRINT.to_owned(),
+        json!(
+            request
+                .fingerprint()
+                .map_err(|_| CaptureFailureKind::Invalid)?
+        ),
+    );
+    let reply = if ack {
+        text("message_id")
+    } else {
+        text("reply_to")
+    };
+    let mut message = prepare_message(
+        sender,
+        recipient,
+        topic,
+        &fitted,
+        text("thread_id"),
+        &tags,
+        if ack {
+            "normal"
+        } else {
+            text("priority").unwrap_or("normal")
+        },
+        !ack && args
+            .get("request_ack")
+            .and_then(Value::as_bool)
+            .unwrap_or(false),
+        reply,
+        &metadata,
+        None,
+        schema,
+    )
+    .message;
+    message.id = request.request_id.to_string();
+    let milliseconds =
+        i64::try_from(request.created_ms).map_err(|_| CaptureFailureKind::Invalid)?;
+    message.timestamp_utc = chrono::DateTime::from_timestamp_millis(milliseconds)
+        .ok_or(CaptureFailureKind::Invalid)?
+        .format("%Y-%m-%dT%H:%M:%S%.6fZ")
+        .to_string();
+    message.client_msg_id = Some(request.request_id.to_string());
+    message.origin_hub = Some(cfg.hub);
+    message.origin_seq = Some(request.sequence);
+    crate::mesh_store::payload_sha256(&message).map_err(capture_error)?;
+    Ok(message)
+}
