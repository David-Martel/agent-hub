+        }
+        if receiver.wrong_ack.load(Ordering::SeqCst) {
+            ack.scope = "foreign".to_owned();
+        }
+        Json(ack).into_response()
+    }
+
+    struct Server {
+        url: String,
+        receiver: Receiver,
+        stop: oneshot::Sender<()>,
+        task: tokio::task::JoinHandle<std::io::Result<()>>,
+    }
+
+    impl Server {
+        async fn start(lose_first_ack: bool, wait: bool) -> Self {
+            Self::start_named(lose_first_ack, wait, "destination").await
+        }
+        async fn start_named(lose_first_ack: bool, wait: bool, local_hub: &str) -> Self {
+            Self::start_with(
+                lose_first_ack,
+                wait,
+                local_hub,
+                &["source"],
+                MemoryStore::default(),
+                Duration::ZERO,
+            )
+            .await
+        }
+        async fn start_with(
+            lose_first_ack: bool,
+            wait: bool,
+            local_hub: &str,
+            incoming: &[&str],
+            store: MemoryStore,
+            commit_delay: Duration,
+        ) -> Self {
+            let receiver = Receiver {
+                local_hub: local_hub.to_owned(),
+                inbound: incoming
+                    .iter()
+                    .map(|peer| {
+                        (
+                            (*peer).to_owned(),
+                            BearerToken::new("synthetic-peer-fixture"),
+                        )
+                    })
+                    .collect(),
+                commit_delay,
+                store,
+                lose_first_ack: Arc::new(AtomicBool::new(lose_first_ack)),
+                wrong_ack: Arc::new(AtomicBool::new(false)),
+                received: Arc::new(AtomicUsize::new(0)),
+                entered: Arc::new(Notify::new()),
+                release: wait.then(|| Arc::new(Notify::new())),
+            };
+            let listener = tokio::net::TcpListener::bind((std::net::Ipv4Addr::LOCALHOST, 0))
+                .await
+                .unwrap();
+            let url = format!("http://localhost:{}", listener.local_addr().unwrap().port());
+            let router = Router::new()
+                .route("/mesh/messages", post(endpoint))
+                .layer(axum::extract::DefaultBodyLimit::max(MAX_BODY_BYTES))
+                .with_state(receiver.clone());
+            let (stop, stopped) = oneshot::channel();
+            let task = tokio::spawn(async move {
+                axum::serve(listener, router)
+                    .with_graceful_shutdown(async {
+                        let _ = stopped.await;
+                    })
+                    .await
+            });
+            Self {
+                url,
+                receiver,
+                stop,
+                task,
+            }
+        }
+        async fn finish(self) {
+            self.stop.send(()).unwrap();
+            tokio::time::timeout(Duration::from_secs(2), self.task)
+                .await
+                .unwrap()
+                .unwrap()
+                .unwrap();
+        }
+        fn worker(&self, store: MemoryStore) -> PeerWorker<MemoryStore> {
+            PeerWorker::new(
+                PeerConfig::new(
+                    "source".to_owned(),
+                    self.receiver.local_hub.clone(),
+                    "fixture".to_owned(),
+                    &self.url,
+                    BearerToken::new("synthetic-peer-fixture"),
+                    false,
+                )
+                .unwrap(),
+                store,
+            )
+            .unwrap()
+        }
+    }
+
+    fn quick_timing() -> Timing {
+        Timing {
+            connect: Duration::from_millis(50),
+            route: Duration::from_millis(250),
+            exchange: Duration::from_millis(400),
+            poll: Duration::from_millis(10),
+            backoff: Duration::from_millis(10),
+            jitter: Duration::ZERO,
+        }
+    }
