+async fn concurrent_commit_order_cannot_publish_later_sequence_before_earlier_transaction() {
+    let (settings, mut first, _redis) = fixture(Limits::default()).await;
+    let mut second = MeshStore::connect(&settings, &first.scope, Limits::default())
+        .await
+        .unwrap();
+    let mut observer = MeshStore::connect(&settings, &first.scope, Limits::default())
+        .await
+        .unwrap();
+    second
+        .client
+        .batch_execute("SET lock_timeout='2s'")
+        .await
+        .unwrap();
+    let first_message = canonical(&MeshTarget::Bus, &message()).unwrap();
+    let mut transaction = first.client.transaction().await.unwrap();
+    lock_scope(&mut transaction, &first.scope).await.unwrap();
+    let earlier = insert_event(
+        &mut transaction,
+        &first.scope,
+        Limits::default(),
+        &first_message,
+    )
+    .await
+    .unwrap();
+    let second_message = message();
+    let second_id = second_message.id.clone();
+    let worker = tokio::spawn(async move {
+        let result = second.append(&second_message).await;
+        second.close().await.unwrap();
+        result
+    });
+    // Confirm the second real transaction reached PostgreSQL and is blocked
+    // on the scope row, rather than relying on a scheduling sleep.
+    let observed = tokio::time::timeout(Duration::from_secs(1), async {
+        loop {
+            let waiting: bool = observer
+                .client
+                .query_one(
+                    "SELECT EXISTS(SELECT 1 FROM pg_stat_activity \
+                WHERE datname=current_database() AND wait_event_type='Lock' \
+                AND query LIKE '%agent_bus_mesh.scopes%FOR UPDATE%')",
+                    &[],
+                )
+                .await
+                .unwrap()
+                .get(0);
+            if waiting {
+                break;
+            }
+            tokio::task::yield_now().await;
+        }
+    })
+    .await;
+    assert!(
+        observed.is_ok(),
+        "second transaction must actually contend for serialization"
+    );
+    assert!(observer.export(0, 200).await.unwrap().events.is_empty());
+    persist_canonical_history(&mut transaction, &first.message_table, &first_message)
+        .await
+        .unwrap();
+    transaction.commit().await.unwrap();
+    let later = worker.await.unwrap().unwrap();
+    assert!(later.sequence > earlier.sequence);
+    let page = observer.export(0, 200).await.unwrap();
+    assert_eq!(page.events.len(), 2);
+    assert_eq!(page.events[0].sequence, earlier.sequence);
+    assert_eq!(page.events[1].message.id, second_id);
+    first.close().await.unwrap();
+    observer.close().await.unwrap();
