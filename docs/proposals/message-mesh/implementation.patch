+fn recent_message(age_seconds: i64) -> Message {
+    let mut a = message();
+    a.timestamp_utc = (chrono::Utc::now() - chrono::Duration::seconds(age_seconds))
+        .format("%Y-%m-%dT%H:%M:%S%.6fZ")
+        .to_string();
+    a.to = format!("recipient-{}", Uuid::new_v4().simple());
+    a
+}
+
+fn acknowledgement(subject: &str) -> Message {
+    let mut a = recent_message(0);
+    a.to = "all".to_owned();
+    a.topic = "ack".to_owned();
+    a.reply_to = Some(subject.to_owned());
+    a.metadata = json!({"ack_for":subject});
+    a
+}
+
+#[test]
+fn acknowledgement_requires_canonical_uuid_consistent_reply_and_no_recursive_ack_request() {
+    let subject = Uuid::new_v4().to_string();
+    let mut a = acknowledgement(&subject);
+    assert!(payload_sha256(&a).is_ok());
+    a.reply_to = Some(Uuid::new_v4().to_string());
+    assert!(matches!(payload_sha256(&a), Err(MeshError::Invalid)));
+    a = acknowledgement("not-a-uuid");
+    assert!(matches!(payload_sha256(&a), Err(MeshError::Invalid)));
+    a = acknowledgement(&subject);
+    a.request_ack = true;
+    assert!(matches!(payload_sha256(&a), Err(MeshError::Invalid)));
+}
