+            assert_refused(&parent.join(reserved));
+        }
+        assert_eq!(fs::read_dir(&parent).unwrap().count(), 0);
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn unix_nonprivate_file_and_parent_permissions_are_refused() {
+        use std::os::unix::fs::PermissionsExt;
+        let (_root, path) = fixture(&[b'a'; 64]);
+        for mode in [0o644, 0o640, 0o400, 0o700, 0o4600] {
+            fs::set_permissions(&path, fs::Permissions::from_mode(mode)).unwrap();
+            assert_refused(&path);
+        }
+        fs::set_permissions(&path, fs::Permissions::from_mode(0o600)).unwrap();
+        let parent = path.parent().unwrap();
+        fs::set_permissions(parent, fs::Permissions::from_mode(0o755)).unwrap();
+        assert_refused(&path);
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn unix_symlink_and_hardlink_providers_are_refused() {
+        use std::os::unix::fs::symlink;
+        let (_root, path) = fixture(&[b'a'; 64]);
+        let alias = path.with_file_name("symbolic.token");
+        symlink(&path, &alias).unwrap();
+        assert_refused(&alias);
+        let hardlink = path.with_file_name("hardlink.token");
