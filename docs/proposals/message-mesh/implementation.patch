+//! Replicate durable messages independently between explicitly admitted peers.
+//!
+//! This module never handles claims, presence, task ownership or client journals.
+//! Each peer has its own worker, connection pool, deadline and durable cursor.
+//! Store calls finish before network calls begin. Failed acknowledgements leave
+//! the cursor unchanged; destination imports deduplicate stable message IDs.
+
+use std::collections::BTreeMap;
+use std::future::Future;
+use std::sync::{Arc, Mutex};
+use std::time::Duration;
+
+use agent_bus_core::hub_candidates::BearerToken;
+use agent_bus_core::mesh_store::{Limits, MeshError, MeshEvent, MeshPage, MeshReceipt, MeshStore};
+use agent_bus_core::models::Sensitivity;
+use agent_bus_core::settings::Settings;
+use serde::{Deserialize, Serialize};
+#[cfg(test)]
+use tokio::sync::watch;
+
+pub(crate) const MAX_BATCH: usize = 200;
+pub(crate) const MAX_BODY_BYTES: usize = 4 * 1024 * 1024;
+const MAX_ACK_BYTES: usize = 4096;
+const DATABASE_DEADLINE: Duration = Duration::from_secs(5);
+
+#[derive(Debug, Clone, Copy)]
+struct Timing {
+    connect: Duration,
+    route: Duration,
+    exchange: Duration,
+    poll: Duration,
+    backoff: Duration,
+    #[cfg(test)]
+    jitter: Duration,
+}
+
+impl Default for Timing {
+    fn default() -> Self {
+        Self {
+            connect: Duration::from_millis(500),
+            route: Duration::from_secs(10),
+            exchange: Duration::from_secs(15),
+            poll: Duration::from_secs(2),
+            backoff: Duration::from_secs(1),
+            #[cfg(test)]
+            jitter: Duration::from_millis(1020),
+        }
+    }
+}
+
+/// Bounded, sanitized failure categories suitable for health output.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub(crate) enum SyncError {
+    Configuration,
+    Store,
+    Cursor,
+    Page,
+    Capacity,
+    Encode,
+    Network,
+    Http,
+    Response,
+    Identity,
+    Import,
+    Backpressure,
+    Collision,
+    UnknownPeer,
+    Projection,
+}
+
+type SyncResult<T> = Result<T, SyncError>;
+
+/// Both directions require separately provisioned mesh credentials.
+#[derive(Debug, Clone, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct MeshPeerSettings {
+    pub(crate) hub: String,
+    pub(crate) urls: Vec<String>,
+    pub(crate) outbound_token_file: String,
+    pub(crate) inbound_token_file: String,
+    #[serde(default)]
+    pub(crate) allow_private_http: bool,
+}
+
+fn store_error(error: MeshError) -> SyncError {
+    match error {
+        MeshError::Backpressure => SyncError::Backpressure,
+        MeshError::Collision => SyncError::Collision,
+        MeshError::UnknownPeer => SyncError::UnknownPeer,
+        MeshError::CursorChanged => SyncError::Cursor,
+        MeshError::ProjectionUnavailable
+        | MeshError::ProjectionIndeterminate
+        | MeshError::ProjectionHeld
+        | MeshError::ProjectionInvalid => SyncError::Projection,
+        MeshError::Invalid => SyncError::Page,
+        MeshError::Unavailable => SyncError::Store,
+    }
+}
+
+/// Authenticated source page, with source-local sequence positions.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct MeshBatch {
+    pub(crate) source_hub: String,
+    pub(crate) destination_hub: String,
+    pub(crate) scope: String,
+    pub(crate) after: i64,
+    pub(crate) through: i64,
+    pub(crate) events: Vec<MeshEvent>,
+}
+
+/// Destination transaction acknowledgement; emitted only after import commits.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct MeshAck {
+    pub(crate) source_hub: String,
+    pub(crate) destination_hub: String,
+    pub(crate) scope: String,
+    pub(crate) through: i64,
+    pub(crate) accepted: usize,
+    pub(crate) duplicates: usize,
+}
+
+/// Local storage operations; implementations must bound their database waits.
+pub(crate) trait Store: Clone + Send + Sync + 'static {
+    fn cursor(&self, peer: String) -> impl Future<Output = SyncResult<i64>> + Send;
+    fn page(&self, after: i64) -> impl Future<Output = SyncResult<MeshPage>> + Send;
+    fn acknowledge(
+        &self,
+        peer: String,
+        after: i64,
+        through: i64,
+    ) -> impl Future<Output = SyncResult<()>> + Send;
+    fn import(
+        &self,
+        events: Vec<MeshEvent>,
+    ) -> impl Future<Output = SyncResult<MeshReceipt>> + Send;
+}
+
+/// Fresh connections prevent one blocked peer from owning another peer's lock.
+#[derive(Clone)]
+pub(crate) struct PgStore {
+    settings: Arc<Settings>,
+    scope: String,
+    limits: Limits,
+}
+
+impl std::fmt::Debug for PgStore {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        formatter
+            .debug_struct("PgStore")
+            .field("scope", &self.scope)
+            .field("limits", &self.limits)
+            .finish_non_exhaustive()
+    }
+}
+
+impl PgStore {
+    pub(crate) fn new(settings: Arc<Settings>, scope: String, limits: Limits) -> Self {
+        Self {
+            settings,
+            scope,
+            limits,
+        }
+    }
+
+    async fn call(&self, operation: StoreOperation) -> SyncResult<StoreReply> {
+        // connect owns bounded bootstrap/driver cleanup, including failures.
+        let mut store = MeshStore::connect(&self.settings, &self.scope, self.limits)
+            .await
+            .map_err(store_error)?;
+        let result = tokio::time::timeout(DATABASE_DEADLINE, async {
+            match operation {
+                StoreOperation::Cursor(peer) => store
+                    .peer_cursor(&peer)
+                    .await
+                    .map(StoreReply::Cursor)
+                    .map_err(store_error),
+                StoreOperation::Page(after) => store
+                    .export(after, MAX_BATCH.min(self.limits.max_batch))
+                    .await
+                    .map(StoreReply::Page)
+                    .map_err(store_error),
+                StoreOperation::Acknowledge {
+                    peer,
+                    after,
+                    through,
+                } => store
+                    .ack_peer(&peer, after, through)
+                    .await
+                    .map(|()| StoreReply::Acknowledged)
+                    .map_err(store_error),
+                StoreOperation::Import(events) => store
+                    .import(&events)
+                    .await
+                    .map(StoreReply::Imported)
+                    .map_err(store_error),
+            }
+        })
+        .await
+        .map_err(|_| SyncError::Store)
+        .and_then(std::convert::identity);
+        // A timed-out query future is dropped above; explicitly abort and join
+        // its owned PG driver before returning, including the first failure.
+        let closed = store.close().await.map_err(store_error);
+        let reply = result?;
+        closed?;
+        Ok(reply)
+    }
+}
+
+enum StoreOperation {
+    Cursor(String),
+    Page(i64),
+    Acknowledge {
+        peer: String,
+        after: i64,
+        through: i64,
+    },
+    Import(Vec<MeshEvent>),
+}
+
+enum StoreReply {
+    Cursor(i64),
+    Page(MeshPage),
+    Acknowledged,
+    Imported(MeshReceipt),
+}
+
+impl Store for PgStore {
+    async fn cursor(&self, peer: String) -> SyncResult<i64> {
+        match self.call(StoreOperation::Cursor(peer)).await? {
+            StoreReply::Cursor(cursor) => Ok(cursor),
+            _ => Err(SyncError::Store),
+        }
+    }
+
+    async fn page(&self, after: i64) -> SyncResult<MeshPage> {
+        match self.call(StoreOperation::Page(after)).await? {
+            StoreReply::Page(page) => Ok(page),
+            _ => Err(SyncError::Store),
+        }
+    }
+
+    async fn acknowledge(&self, peer: String, after: i64, through: i64) -> SyncResult<()> {
+        match self
+            .call(StoreOperation::Acknowledge {
+                peer,
+                after,
+                through,
+            })
+            .await?
+        {
+            StoreReply::Acknowledged => Ok(()),
+            _ => Err(SyncError::Store),
+        }
+    }
+
+    async fn import(&self, events: Vec<MeshEvent>) -> SyncResult<MeshReceipt> {
+        match self.call(StoreOperation::Import(events)).await? {
+            StoreReply::Imported(receipt) => Ok(receipt),
+            _ => Err(SyncError::Store),
+        }
+    }
+}
+
+/// Validated peer configuration. Token debug formatting is always redacted.
+#[derive(Debug, Clone)]
+pub(crate) struct PeerConfig {
+    pub(crate) local_hub: String,
+    pub(crate) peer_hub: String,
+    pub(crate) scope: String,
+    base_urls: Vec<String>,
+    token: BearerToken,
+}
+
+fn valid_name(name: &str) -> bool {
+    !name.is_empty()
+        && name.len() <= 128
+        && name
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || b"-_.".contains(&byte))
+}
+
+impl PeerConfig {
+    /// Validate a separately provisioned peer credential and explicit route.
+    #[cfg(test)]
+    pub(crate) fn new(
+        local_hub: String,
+        peer_hub: String,
+        scope: String,
+        base_url: &str,
+        token: BearerToken,
+        allow_private_http: bool,
+    ) -> SyncResult<Self> {
+        Self::with_urls(
+            local_hub,
+            peer_hub,
+            scope,
+            &[base_url.to_owned()],
+            token,
+            allow_private_http,
+        )
+    }
+
+    pub(crate) fn with_urls(
+        local_hub: String,
+        peer_hub: String,
+        scope: String,
+        base_urls: &[String],
+        token: BearerToken,
+        allow_private_http: bool,
+    ) -> SyncResult<Self> {
+        if !valid_name(&local_hub)
+            || !valid_name(&peer_hub)
+            || !valid_name(&scope)
+            || local_hub == peer_hub
+            || token.expose().trim().is_empty()
+            || base_urls.is_empty()
+            || base_urls.len() > 8
+        {
+            return Err(SyncError::Configuration);
+        }
+        let mut normalized = Vec::new();
+        for base_url in base_urls {
+            let url = reqwest::Url::parse(base_url).map_err(|_| SyncError::Configuration)?;
+            let loopback = match url.host() {
+                Some(url::Host::Domain(host)) => host.eq_ignore_ascii_case("localhost"),
+                Some(url::Host::Ipv4(address)) => address.is_loopback(),
+                Some(url::Host::Ipv6(address)) => address.is_loopback(),
+                None => return Err(SyncError::Configuration),
+            };
+            let private_literal = match url.host() {
+                Some(url::Host::Ipv4(address)) => {
+                    address.is_private()
+                        || address.is_link_local()
+                        || (address.octets()[0] == 100 && (64..=127).contains(&address.octets()[1]))
+                }
+                Some(url::Host::Ipv6(address)) => {
+                    address.is_unique_local() || address.is_unicast_link_local()
+                }
+                _ => false,
+            };
+            if !url.username().is_empty()
+                || url.password().is_some()
+                || url.query().is_some()
+                || url.fragment().is_some()
+                || url.path() != "/"
+                || !(url.scheme() == "https"
+                    || (url.scheme() == "http"
+                        && (loopback || (allow_private_http && private_literal))))
+            {
+                return Err(SyncError::Configuration);
+            }
+            let canonical = url.as_str().trim_end_matches('/').to_owned();
+            if !normalized.contains(&canonical) {
+                normalized.push(canonical);
+            }
+        }
+        Ok(Self {
+            local_hub,
+            peer_hub,
+            scope,
+            base_urls: normalized,
+            token,
+        })
+    }
+}
+
+/// Bounded peer diagnostics; never includes messages, credentials or raw errors.
+#[derive(Debug, Default, Clone, Serialize)]
+pub(crate) struct PeerStatus {
+    pub(crate) successful_batches: u64,
+    pub(crate) failures: u64,
+    pub(crate) acknowledged_through: i64,
+    pub(crate) last_error: Option<SyncError>,
+    pub(crate) excluded_messages: u64,
+}
+
+/// One peer's independently pooled transport and local store adapter.
+#[derive(Debug)]
+pub(crate) struct PeerWorker<S> {
+    config: PeerConfig,
+    store: S,
+    client: reqwest::Client,
+    timing: Timing,
+    next_route: Mutex<usize>,
+    pub(crate) status: Arc<Mutex<PeerStatus>>,
+}
+
+impl<S: Store> PeerWorker<S> {
+    pub(crate) fn new(config: PeerConfig, store: S) -> SyncResult<Self> {
+        Self::with_timing(config, store, Timing::default())
+    }
+
+    fn with_timing(config: PeerConfig, store: S, timing: Timing) -> SyncResult<Self> {
+        if timing.connect.is_zero()
+            || timing.route.is_zero()
+            || timing.exchange.is_zero()
+            || timing.route > timing.exchange
+            || timing.connect > timing.route
+            || timing.poll.is_zero()
+            || timing.backoff.is_zero()
+        {
+            return Err(SyncError::Configuration);
+        }
+        let client = reqwest::Client::builder()
+            .no_proxy()
+            .redirect(reqwest::redirect::Policy::none())
+            .connect_timeout(timing.connect)
+            .timeout(timing.route)
+            .pool_max_idle_per_host(1)
+            .build()
+            .map_err(|_| SyncError::Configuration)?;
+        Ok(Self {
+            config,
+            store,
+            client,
+            timing,
+            next_route: Mutex::new(0),
+            status: Arc::new(Mutex::new(PeerStatus::default())),
+        })
+    }
+
+    /// Send one page; acknowledge locally only after a matching committed receipt.
+    pub(crate) async fn push_once(&self) -> SyncResult<bool> {
+        let after = self.store.cursor(self.config.peer_hub.clone()).await?;
+        let page = self.store.page(after).await?;
+        let has_more = page.has_more;
+        let excluded = page.excluded;
+        let batch = MeshBatch {
+            source_hub: self.config.local_hub.clone(),
+            destination_hub: self.config.peer_hub.clone(),
+            scope: self.config.scope.clone(),
+            after,
+            through: page.through,
+            events: page.events,
+        };
+        validate_batch(&batch)?;
+        if batch.through == after {
+            return Ok(false);
+        }
+        let body = encode_batch(&batch)?;
+        // Every local database call above has completed and released its locks.
+        let start = *self
+            .next_route
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        let ack = tokio::time::timeout(self.timing.exchange, async {
+            let mut last_error = SyncError::Network;
+            for offset in 0..self.config.base_urls.len() {
+                let index = (start + offset) % self.config.base_urls.len();
+                let base_url = &self.config.base_urls[index];
+                // Advance before awaiting so aggregate cancellation cannot
+                // reset every retry to the first unresponsive routes.
+                *self
+                    .next_route
+                    .lock()
+                    .unwrap_or_else(std::sync::PoisonError::into_inner) =
+                    (index + 1) % self.config.base_urls.len();
+                match self.exchange(base_url, &body, &batch).await {
+                    Ok(ack) => {
+                        *self
+                            .next_route
+                            .lock()
+                            .unwrap_or_else(std::sync::PoisonError::into_inner) = index;
+                        return Ok(ack);
+                    }
+                    Err(error) => last_error = error,
+                }
+            }
+            Err(last_error)
+        })
+        .await
+        .map_err(|_| SyncError::Network)??;
+        if ack.source_hub != batch.source_hub
+            || ack.destination_hub != batch.destination_hub
+            || ack.scope != batch.scope
+            || ack.through != batch.through
+            || ack.accepted.checked_add(ack.duplicates) != Some(batch.events.len())
+        {
+            return Err(SyncError::Identity);
+        }
+        self.store
+            .acknowledge(self.config.peer_hub.clone(), after, batch.through)
+            .await?;
+        let mut status = self
+            .status
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        status.successful_batches = status.successful_batches.saturating_add(1);
+        status.acknowledged_through = batch.through;
+        status.excluded_messages = status
+            .excluded_messages
+            .saturating_add(u64::try_from(excluded).unwrap_or(u64::MAX));
+        status.last_error = None;
+        Ok(has_more)
+    }
+
+    async fn exchange(
+        &self,
+        base_url: &str,
+        body: &[u8],
+        batch: &MeshBatch,
+    ) -> SyncResult<MeshAck> {
+        let request = self
+            .client
+            .post(format!("{base_url}/mesh/messages"))
+            .bearer_auth(self.config.token.expose())
+            .header("x-agent-bus-peer", &self.config.local_hub)
+            .header(reqwest::header::CONTENT_TYPE, "application/json")
+            .timeout(self.timing.route)
+            .body(body.to_vec());
+        let mut response = request.send().await.map_err(|_| SyncError::Network)?;
+        if !response.status().is_success() {
+            return Err(match response.status().as_u16() {
+                401 | 403 => SyncError::Identity,
+                409 => SyncError::Collision,
+                429 | 507 => SyncError::Backpressure,
+                _ => SyncError::Http,
+            });
+        }
+        if response
+            .content_length()
+            .is_some_and(|bytes| bytes > u64::try_from(MAX_ACK_BYTES).unwrap_or(u64::MAX))
+        {
+            return Err(SyncError::Capacity);
+        }
+        let mut bytes = Vec::new();
+        while let Some(chunk) = response.chunk().await.map_err(|_| SyncError::Network)? {
+            if bytes.len().saturating_add(chunk.len()) > MAX_ACK_BYTES {
+                return Err(SyncError::Capacity);
+            }
+            bytes.extend_from_slice(&chunk);
+        }
+        let ack: MeshAck = serde_json::from_slice(&bytes).map_err(|_| SyncError::Response)?;
+        if ack.source_hub != batch.source_hub
+            || ack.destination_hub != batch.destination_hub
+            || ack.scope != batch.scope
+            || ack.through != batch.through
+            || ack.accepted.checked_add(ack.duplicates) != Some(batch.events.len())
+        {
+            return Err(SyncError::Identity);
+        }
+        Ok(ack)
+    }
+
+    /// Run independently; shutdown waits for in-flight bounded store cleanup.
+    #[cfg(test)]
+    pub(crate) async fn run(self, mut stop: watch::Receiver<bool>) {
+        let mut failures = 0_u32;
+        loop {
+            if *stop.borrow() {
+                return;
+            }
+            let delay = match self.push_once().await {
+                Ok(has_more) => {
+                    failures = 0;
+                    if has_more {
+                        Duration::from_millis(10)
+                    } else {
+                        self.timing.poll
+                    }
+                }
+                Err(error) => {
+                    {
+                        let mut status = self
+                            .status
+                            .lock()
+                            .unwrap_or_else(std::sync::PoisonError::into_inner);
+                        status.failures = status.failures.saturating_add(1);
+                        status.last_error = Some(error);
+                    }
+                    let factor = 1_u32 << failures.min(5);
+                    failures = failures.saturating_add(1);
+                    // Independent UUID jitter avoids synchronized reconnect storms.
+                    let jitter = u32::from(uuid::Uuid::new_v4().as_bytes()[0]);
+                    self.timing
+                        .backoff
+                        .saturating_mul(factor)
+                        .saturating_add(self.timing.jitter.saturating_mul(jitter) / 255)
+                }
+            };
+            tokio::select! {
+                () = tokio::time::sleep(delay) => {}
+                result = stop.changed() => {
+                    if result.is_err() || *stop.borrow() { return; }
+                }
+            }
+        }
+    }
+}
+
+/// Verify peer authentication before body decoding or database access.
+pub(crate) fn authenticate_peer(
+    headers: &axum::http::HeaderMap,
+    inbound: &BTreeMap<String, BearerToken>,
+) -> SyncResult<String> {
+    if headers.get_all("x-agent-bus-peer").iter().count() != 1
+        || headers
+            .get_all(axum::http::header::AUTHORIZATION)
+            .iter()
+            .count()
+            != 1
+    {
+        return Err(SyncError::Identity);
+    }
+    let peer = headers
+        .get("x-agent-bus-peer")
+        .and_then(|value| value.to_str().ok())
+        .filter(|peer| valid_name(peer))
+        .ok_or(SyncError::Identity)?;
+    let expected = inbound.get(peer).ok_or(SyncError::Identity)?;
+    if expected.expose().trim().is_empty() {
+        return Err(SyncError::Identity);
+    }
+    let supplied = headers
+        .get(axum::http::header::AUTHORIZATION)
+        .and_then(|value| value.to_str().ok())
+        .and_then(|value| value.strip_prefix("Bearer "))
+        .ok_or(SyncError::Identity)?;
+    if supplied.len() > 1024 || expected.expose().len() > 1024 {
+        return Err(SyncError::Identity);
+    }
+    let mut difference = supplied.len() ^ expected.expose().len();
+    for index in 0..1024 {
+        difference |= usize::from(
+            supplied.as_bytes().get(index).copied().unwrap_or(0)
+                ^ expected
+                    .expose()
+                    .as_bytes()
+                    .get(index)
+                    .copied()
+                    .unwrap_or(0),
+        );
+    }
+    if difference != 0 {
+        return Err(SyncError::Identity);
+    }
+    Ok(peer.to_owned())
+}
+
+fn validate_batch(batch: &MeshBatch) -> SyncResult<()> {
+    if !valid_name(&batch.source_hub)
+        || !valid_name(&batch.destination_hub)
+        || !valid_name(&batch.scope)
+        || batch.source_hub == batch.destination_hub
+        || batch.after < 0
+        || batch.through < batch.after
+        || batch.events.len() > MAX_BATCH
+    {
+        return Err(SyncError::Page);
+    }
+    let mut last = batch.after;
+    for event in &batch.events {
+        if event.sequence <= last
+            || event.sequence > batch.through
+            || event.message.effective_sensitivity() == Sensitivity::NoOffsite
+        {
+            return Err(SyncError::Page);
+        }
+        last = event.sequence;
+    }
+    Ok(())
+}
+
+fn encode_batch(batch: &MeshBatch) -> SyncResult<Vec<u8>> {
+    struct Capped(Vec<u8>);
+    impl std::io::Write for Capped {
+        fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+            if self.0.len().saturating_add(bytes.len()) > MAX_BODY_BYTES {
+                return Err(std::io::Error::other("mesh batch exceeds byte bound"));
+            }
+            self.0.extend_from_slice(bytes);
+            Ok(bytes.len())
+        }
+        fn flush(&mut self) -> std::io::Result<()> {
+            Ok(())
+        }
+    }
+    let mut body = Capped(Vec::new());
+    serde_json::to_writer(&mut body, batch).map_err(|error| {
+        if error.is_io() {
+            SyncError::Capacity
+        } else {
+            SyncError::Encode
+        }
+    })?;
+    Ok(body.0)
+}
+
+/// Import after dedicated peer authentication; never use the global/cloud token.
+///
+/// The HTTP router must cap request bytes before JSON decoding and bind the
+/// authenticated peer identity to `source_hub`. This function also binds the
+/// configured destination and scope before invoking the atomic core import.
+pub(crate) async fn receive<S: Store>(
+    store: &S,
+    authenticated_peer: &str,
+    local_hub: &str,
+    scope: &str,
+    batch: MeshBatch,
+) -> SyncResult<MeshAck> {
+    if batch.source_hub != authenticated_peer
+        || batch.destination_hub != local_hub
+        || batch.scope != scope
+    {
+        return Err(SyncError::Identity);
+    }
+    validate_batch(&batch)?;
+    let expected = batch.events.len();
+    let receipt = store.import(batch.events).await?;
+    if receipt.accepted.checked_add(receipt.duplicates) != Some(expected) {
+        return Err(SyncError::Import);
+    }
+    Ok(MeshAck {
+        source_hub: batch.source_hub,
+        destination_hub: batch.destination_hub,
+        scope: batch.scope,
+        through: batch.through,
+        accepted: receipt.accepted,
+        duplicates: receipt.duplicates,
+    })
+}
