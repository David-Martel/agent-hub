+
+struct AckEffect {
+    subject: String,
+    mode: &'static str,
+    pending_expires_ms: i64,
+    deadline_expires_ms: i64,
+    pending_json: String,
+    deadline_json: String,
+}
+
+fn ack_effect(event: &MeshEvent, canonical: &Canonical) -> MeshResult<AckEffect> {
+    let msg = &event.message;
+    let subject = canonical.acknowledges.unwrap_or(canonical.id).to_string();
+    let mode = if canonical.acknowledges.is_some() {
+        "ack"
+    } else if matches!(event.target, MeshTarget::Bus) && msg.request_ack {
+        "request"
+    } else {
+        "none"
+    };
+    let timestamp = crate::postgres_store::parse_timestamp_utc(&msg.timestamp_utc)
+        .map_err(|_| MeshError::Invalid)?;
+    let pending_expires = timestamp
+        .checked_add_signed(chrono::Duration::seconds(300))
+        .ok_or(MeshError::Invalid)?;
+    let seconds = i64::try_from(crate::models::ack_deadline_seconds(&msg.priority))
+        .map_err(|_| MeshError::Invalid)?;
+    let deadline = timestamp
+        .checked_add_signed(chrono::Duration::seconds(seconds))
+        .ok_or(MeshError::Invalid)?;
+    let pending_json =
+        json!({"message_id":msg.id,"recipient":msg.to,"sent_at":msg.timestamp_utc}).to_string();
+    let deadline_json = serde_json::to_string(&crate::models::AckDeadline {
+        message_id: msg.id.clone(),
+        recipient: msg.to.clone(),
+        deadline_at: deadline.format("%Y-%m-%dT%H:%M:%S%.6fZ").to_string(),
+        escalation_level: 0,
+        escalated_to: None,
+    })
+    .map_err(|_| MeshError::Invalid)?;
+    Ok(AckEffect {
+        subject,
+        mode,
+        pending_expires_ms: pending_expires.timestamp_millis(),
+        deadline_expires_ms: deadline.timestamp_millis(),
+        pending_json,
+        deadline_json,
+    })
+}
+
+fn projection_error(error: &redis::RedisError) -> MeshError {
+    match error.code() {
+        Some("MESH_ID_COLLISION") => MeshError::Collision,
+        Some("MESH_PROJECTION_PENDING") => MeshError::ProjectionIndeterminate,
+        Some(
+            "MESH_PROJECTION_INVALID"
+            | "MESH_PROJECTION_KEY_TYPE"
+            | "MESH_PROJECTION_PERMISSION"
+            | "MESH_REQUIRES_REDIS_ACL_PREFLIGHT",
+        ) => MeshError::ProjectionInvalid,
+        _ => MeshError::ProjectionUnavailable,
+    }
+}
+
+async fn project_redis_with_ack(
+    conn: &mut redis::aio::MultiplexedConnection,
+    settings: &Settings,
+    scope: &str,
+    event: &MeshEvent,
+    acknowledged: bool,
+) -> MeshResult<String> {
+    let canonical = canonical(&event.target, &event.message)?;
+    let msg = &event.message;
+    let mut fields = Vec::<String>::new();
+    let object = canonical.json.as_object().ok_or(MeshError::Invalid)?;
+    for (key, value) in object {
+        let key = key.as_str();
+        if key == "stream_id" {
+            continue;
+        }
+        fields.push(key.to_owned());
+        fields.push(
+            value
+                .as_str()
+                .map_or_else(|| value.to_string(), str::to_owned),
+        );
+    }
+    let notification = if !matches!(event.target, MeshTarget::Bus) || msg.to == "all" {
+        None
+    } else {
+        Some(vec![
+            "id".to_owned(),
+            msg.id.clone(),
+            "agent".to_owned(),
+            msg.to.clone(),
+            "created_at".to_owned(),
+            msg.timestamp_utc.clone(),
+            "reason".to_owned(),
+            crate::redis_bus::notification_reason(msg).to_owned(),
+            "requires_ack".to_owned(),
+            msg.request_ack.to_string(),
+        ])
+    };
+    let (stream_key, stream_maxlen, stream_ttl, publish) = match &event.target {
+        MeshTarget::Bus => (
+            settings.stream_key.clone(),
+            settings.stream_maxlen,
+            0_u64,
+            true,
+        ),
+        MeshTarget::Direct { agents } => (
+            format!("bus:direct:{}:{}", agents[0], agents[1]),
+            1000,
+            604_800,
+            false,
+        ),
+        MeshTarget::Group { name } => (format!("bus:group:{name}"), 1000, 2_592_000, false),
+    };
+    let ack = ack_effect(event, &canonical)?;
+    let input = json!({ "fingerprint":canonical.sha256,"stream_maxlen":stream_maxlen,
+        "stream_ttl":stream_ttl,"publish":publish,
+        "message_fields":fields,"message_json":serde_json::to_string(&canonical.json).map_err(|_| MeshError::Invalid)?,
+        "notification_fields":notification,"key_types":["string","stream"],
+        "ack_mode":ack.mode,"ack_event_id":msg.id,"acknowledged":acknowledged,
+        "pending_expires_ms":ack.pending_expires_ms,"deadline_expires_ms":ack.deadline_expires_ms,
+        "pending_json":ack.pending_json,"deadline_json":ack.deadline_json });
+    // Channel key need not exist: TYPE is not meaningful for pub/sub channels.
+    let notification_key = crate::redis_bus::notification_stream_key(&msg.to);
+    let serialized = serde_json::to_string(&input).map_err(|_| MeshError::Invalid)?;
+    redis::Script::new(include_str!("mesh_project.lua"))
+        .key(projection_key(scope, &msg.id))
+        .key(stream_key)
+        .key(&settings.channel_key)
+        .key(notification_key)
+        .key(format!("agent_bus:pending_ack:{}", ack.subject))
+        .key(format!("agent_bus:ack_deadline:{}", ack.subject))
+        .key(acknowledged_key(scope, &ack.subject))
+        .arg(serialized)
+        .invoke_async(conn)
+        .await
+        .map_err(|error| projection_error(&error))
+}
+
+/// Permanent local acknowledgment memo, namespaced by mesh scope and subject UUID.
+#[must_use]
+pub fn acknowledged_key(scope: &str, id: &str) -> String {
+    format!(
+        "agent_bus:mesh_ack:{}:{id}",
+        crate::outbox::digest_hex(scope.as_bytes())
+    )
+}
+
+#[derive(Deserialize)]
+struct AppliedReceipt {
+    state: String,
+    fingerprint: String,
+    stream_id: String,
+    receipt_version: u8,
+    notification_stream_id: Option<String>,
+    notification_id: Option<String>,
+}
+
+fn valid_stream_id(value: &str) -> bool {
+    value
+        .split_once('-')
+        .is_some_and(|(left, right)| left.parse::<u64>().is_ok() && right.parse::<u64>().is_ok())
+}
+
+async fn read_posted_receipt(
+    conn: &mut redis::aio::MultiplexedConnection,
+    scope: &str,
+    event: &MeshEvent,
+) -> MeshResult<crate::redis_bus::PostedMessage> {
+    let expected = target_payload_sha256(&event.target, &event.message)?;
+    let raw: Option<String> = redis::cmd("GET")
+        .arg(projection_key(scope, &event.message.id))
+        .query_async(conn)
+        .await
+        .map_err(|_| MeshError::ProjectionUnavailable)?;
+    let receipt: AppliedReceipt =
+        serde_json::from_str(raw.as_deref().ok_or(MeshError::ProjectionInvalid)?)
+            .map_err(|_| MeshError::ProjectionInvalid)?;
+    if receipt.state != "applied"
+        || receipt.receipt_version != 1
+        || !valid_stream_id(&receipt.stream_id)
+    {
+        return Err(MeshError::ProjectionInvalid);
+    }
+    if receipt.fingerprint != expected {
+        return Err(MeshError::Collision);
+    }
+    let mut message = event.message.clone();
+    message.stream_id = Some(receipt.stream_id);
+    let notifications = if matches!(event.target, MeshTarget::Bus) && message.to != "all" {
+        let id = receipt
+            .notification_id
+            .ok_or(MeshError::ProjectionInvalid)?;
+        let stream = receipt
+            .notification_stream_id
+            .filter(|id| valid_stream_id(id))
+            .ok_or(MeshError::ProjectionInvalid)?;
+        if id != message.id {
+            return Err(MeshError::ProjectionInvalid);
+        }
+        vec![crate::redis_bus::Notification {
+            id,
+            agent: message.to.clone(),
+            created_at: message.timestamp_utc.clone(),
+            reason: crate::redis_bus::notification_reason(&message).to_owned(),
+            requires_ack: message.request_ack,
+            message: message.clone(),
+            notification_stream_id: Some(stream),
+        }]
+    } else {
+        if receipt.notification_id.is_some() || receipt.notification_stream_id.is_some() {
+            return Err(MeshError::ProjectionInvalid);
+        }
+        Vec::new()
+    };
+    Ok(crate::redis_bus::PostedMessage {
+        message,
+        notifications,
+    })
+}
